---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="没有找到这个页面。" noindex>
  <section class="container not-found">
    <p class="eyebrow">ERROR 404</p>
    <p class="not-found-code">404</p>
    <h1>这一页走丢了。</h1>
    <p>可能是地址写错了，也可能它从未存在过。</p>
    <a class="button button-primary" href="/">返回首页 <span>→</span></a>
  </section>
</BaseLayout>
