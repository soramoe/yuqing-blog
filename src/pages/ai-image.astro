---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI 生图"
  description="选择模型，输入中文提示词，可选参考图与批量生成。消耗积分，失败自动退回。"
  bodyClass="page-ai-image"
  noindex
>
  <main class="ai-shell">
    <p class="eyebrow">AI IMAGE STUDIO</p>
    <h1>AI 生图</h1>
    <p class="ai-lead">
      中文自动翻译（Colab/云模型均适配）。左侧配置，右侧出图。失败自动退积分。
    </p>

    <div id="login-card" class="ai-card" hidden>
      <h2>登录后才能使用</h2>
      <p class="ai-muted">
        生图消耗积分，只有登录用户可以画。登录后每天签到还能攒积分。
      </p>
      <div class="ai-actions">
        <a class="button button-primary" href="/login/">去登录</a>
        <a class="text-link" href="/points/">了解积分 <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div id="app" hidden>
      <div class="ai-statusbar">
        <span id="service-badge" class="ai-badge" data-state="checking">检查服务…</span>
        <span id="balance-chip" class="ai-chip" hidden>
          积分余额 <strong id="balance-value">–</strong>
        </span>
        <span id="price-chip" class="ai-chip" hidden>
          单张 <strong id="price-value">–</strong> 积分
          <span id="price-hd-hint" class="ai-price-muted"></span>
        </span>
        <a href="/my-images/" class="ai-chip ai-link">我的生图历史 →</a>
      </div>

      <div class="ai-layout">
        <!-- ============ 左：配置 ============ -->
        <div class="ai-left">
          <section class="ai-section">
            <div class="ai-section-head">
              <p class="ai-section-label">选择模型</p>
              <span id="service-badge-mini" class="ai-mini-status"></span>
            </div>
            <select id="model-select" class="ai-model-select" hidden aria-label="选择生图模型"></select>
            <p id="model-hint" class="ai-model-hint" hidden></p>
          </section>

          <form id="gen-form" class="ai-form ai-card">
            <label>
              主体描述（必填）
              <textarea id="prompt" rows="3" maxlength="800" required placeholder="例如：一只橘白色的猫穿着古代官服，站在雪后的江南石桥上，手里捧着发光的红灯笼"></textarea>
            </label>
            <label>
              第二提示词（可选，写给 SDXL 第二文本编码器）
              <input id="prompt2" maxlength="800" placeholder="例如：电影感构图，细致的光影层次" />
            </label>
            <label>
              负面提示词（可选）
              <input id="negative" maxlength="500" placeholder="例如：模糊，低质量，多余的手指" />
            </label>
            <div class="ai-grid">
              <label>
                清晰度
                <select id="quality">
                  <option value="standard" selected>1K 标准</option>
                  <option value="hd">2K 高清</option>
                </select>
              </label>
              <label>
                生成张数（1~4）
                <select id="batch">
                  <option value="1" selected>1 张</option>
                  <option value="2">2 张</option>
                  <option value="3">3 张</option>
                  <option value="4">4 张</option>
                </select>
              </label>
            </div>
            <div class="ai-grid">
              <label>
                画面比例
                <select id="ratio">
                  <option value="1:1" selected>1:1 方形</option>
                  <option value="16:9">16:9 横版</option>
                  <option value="9:16">9:16 竖版</option>
                  <option value="4:3">4:3 横版</option>
                  <option value="3:4">3:4 竖版</option>
                  <option value="21:9">21:9 超宽</option>
                  <option value="auto">自动（由提示词决定）</option>
                </select>
              </label>
              <label id="jump-wrap" class="ai-jump" hidden>
                插队优先生成
                <span class="ai-jump-inner">
                  <input id="jump" type="checkbox" />
                  <span>消耗 <strong data-jump-fee>–</strong> 积分</span>
                </span>
              </label>
            </div>
            <label>
              参考图（可选，上传后按参考图+提示词生图；当前 Colab / 火山方舟模型支持）
              <input id="ref-image" type="file" accept="image/png,image/jpeg,image/webp" hidden />
              <span
                id="ref-drop"
                class="ai-ref-drop"
                tabindex="0"
                role="button"
              >点击或拖入参考图（PNG/JPG/WebP，≤8MB）</span>
              <span id="ref-preview" class="ai-ref-preview" hidden>
                <img data-ref-thumb alt="参考图预览" />
                <button type="button" data-ref-clear class="ai-ref-clear">移除</button>
              </span>
            </label>
            <label class="ai-jump ai-gallery-check">
              <input id="gallery-check" type="checkbox" />
              <span>生成后上传到站内图库（公开可见）</span>
            </label>
            <div class="ai-submit-row">
              <button id="submit" class="button button-primary" type="submit">
                开始生成
              </button>
              <span id="queue-line" class="ai-queue" hidden></span>
            </div>
          </form>

          <p id="status" class="ai-status">正在检查服务状态…</p>
          <p id="translated-line" class="ai-translated" hidden></p>
        </div>

        <!-- ============ 右：结果 ============ -->
        <div class="ai-right">
          <section class="ai-section ai-results-panel">
            <div class="ai-section-head">
              <p class="ai-section-label">生成结果</p>
              <span data-batch-progress hidden></span>
            </div>
            <div id="result-grid" class="ai-result-grid">
              <div class="ai-result-empty" data-result-empty>
                🖼️ 生成的图片会显示在这里
              </div>
            </div>
          </section>

          <section class="ai-section" id="history-section" hidden>
            <p class="ai-section-label">
              本次会话
              <a href="/my-images/" class="ai-history-link">全部历史 →</a>
            </p>
            <div id="history" class="ai-history"></div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .ai-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .ai-lead {
    color: var(--muted);
    margin: 0 0 1.4rem;
  }
  .ai-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 1.6rem;
    display: grid;
    gap: 0.8rem;
  }
  .ai-card h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .ai-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .ai-statusbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }
  .ai-badge,
  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
  }
  .ai-badge[data-state="online"] {
    color: #7ec699;
    border-color: rgb(83 160 112 / 45%);
  }
  .ai-badge[data-state="cooldown"],
  .ai-badge[data-state="busy"] {
    color: #e2a355;
    border-color: rgb(205 125 54 / 45%);
  }
  .ai-badge[data-state="offline"] {
    color: var(--bad, #e07a5f);
    border-color: rgb(224 122 95 / 45%);
  }
  .ai-chip strong {
    color: var(--text);
  }
  .ai-price-muted {
    color: var(--muted);
    font-size: 0.72em;
  }
  .ai-link {
    text-decoration: none;
    color: var(--accent);
  }
  .ai-layout {
    display: grid;
    grid-template-columns: minmax(340px, 430px) 1fr;
    gap: 1.4rem;
    align-items: start;
  }
  @media (max-width: 1023px) {
    .ai-layout {
      grid-template-columns: 1fr;
    }
  }
  .ai-section {
    margin-bottom: 0;
  }
  .ai-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
  }
  .ai-section-label {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .ai-mini-status {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .ai-model-select {
    width: 100%;
    padding: 0.62rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .ai-model-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .ai-model-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ai-model-hint {
    margin: 0.45rem 0 0;
    font-size: 0.72rem;
    color: var(--muted);
    font-family: Consolas, monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ai-form {
    display: grid;
    gap: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 1.4rem;
  }
  .ai-form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ai-form textarea,
  .ai-form input:not([type="checkbox"]):not([type="file"]),
  .ai-form select {
    padding: 0.62rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--background);
    color: var(--text);
    font: inherit;
    resize: vertical;
  }
  .ai-form textarea:focus,
  .ai-form input:not([type="checkbox"]):not([type="file"]):focus,
  .ai-form select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .ai-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .ai-jump {
    cursor: pointer;
    align-content: start;
  }
  .ai-jump-inner {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
    font-size: 0.85rem;
  }
  .ai-jump input {
    width: auto;
  }
  .ai-jump[hidden] {
    display: none !important;
  }
  .ai-gallery-check {
    flex-direction: row !important;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--text);
    font-size: 0.85rem;
  }
  .ai-gallery-check input {
    width: auto;
  }
  .ai-ref-drop {
    padding: 0.7rem 0.85rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .ai-ref-drop:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .ai-ref-preview {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ai-ref-preview img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .ai-ref-clear {
    border: 0;
    background: transparent;
    color: var(--bad, #e07a5f);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0.2rem;
  }
  .ai-submit-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .ai-submit-row button {
    cursor: pointer;
    min-width: 8rem;
  }
  .ai-submit-row button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ai-queue {
    color: #e2a355;
    font-size: 0.8rem;
  }
  .ai-status {
    color: var(--muted);
    min-height: 1.5em;
  }
  .ai-translated {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
    margin: -0.3rem 0 0.8rem;
  }
  .ai-results-panel {
    min-height: 320px;
  }
  .ai-result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.9rem;
  }
  .ai-result-empty {
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 2.4rem 1rem;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .ai-result-slot {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    display: grid;
    align-content: start;
  }
  .ai-result-slot .slot-image-wrap {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--border) 25%, transparent);
    color: var(--muted);
    font-size: 0.8rem;
    min-height: 160px;
  }
  .ai-result-slot .slot-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }
  .ai-result-slot .slot-image-wrap.loading::after {
    content: "";
    width: 22px;
    height: 22px;
    border: 2px solid var(--accent);
    border-top-color: transparent;
    border-radius: 999px;
    animation: ai-spin 0.8s linear infinite;
  }
  @keyframes ai-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .ai-result-slot .slot-info {
    padding: 0.55rem 0.7rem 0.7rem;
    font-size: 0.72rem;
    color: var(--muted);
    display: grid;
    gap: 0.2rem;
  }
  .ai-result-slot[data-state="failed"] .slot-image-wrap {
    color: var(--bad, #e07a5f);
  }
  .ai-result-slot .slot-actions {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .ai-result-slot .slot-actions button,
  .ai-result-slot .slot-actions a {
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--accent);
    text-decoration: none;
    cursor: pointer;
  }
  .ai-section-label {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.6rem 0 0.6rem;
  }
  .ai-history-link {
    color: var(--accent);
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0;
    margin-left: 0.4rem;
  }
  .ai-history {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ai-muted {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>

<style is:global>
  /* 历史缩略图由 JS 动态创建，样式需全局生效 */
  .ai-history img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border);
    cursor: pointer;
  }
</style>

<script>
  interface ModelInfo {
    id: string;
    name: string;
    model: string;
    adapter: string;
    status: "ready" | "cooldown" | "offline" | "unconfigured";
    supportsInitImage?: boolean;
  }

  interface BatchSlot {
    index: number;
    requestId: string;
    el: HTMLElement;
    imgWrap: HTMLElement;
    info: HTMLElement;
    url: string | null;
  }

  const $ = (id: string) => document.getElementById(id);
  const loginCard = $("login-card") as HTMLElement;
  const app = $("app") as HTMLElement;
  const badge = $("service-badge") as HTMLElement;
  const miniStatus = $("service-badge-mini") as HTMLElement;
  const balanceChip = $("balance-chip") as HTMLElement;
  const balanceValue = $("balance-value") as HTMLElement;
  const priceChip = $("price-chip") as HTMLElement;
  const priceValue = $("price-value") as HTMLElement;
  const priceHdHint = $("price-hd-hint") as HTMLElement;
  const modelSelect = $("model-select") as HTMLSelectElement;
  const modelHint = $("model-hint") as HTMLElement;
  const form = document.getElementById("gen-form") as HTMLFormElement;
  const btn = $("submit") as HTMLButtonElement;
  const promptInput = $("prompt") as HTMLTextAreaElement;
  const prompt2Input = $("prompt2") as HTMLInputElement;
  const negativeInput = $("negative") as HTMLInputElement;
  const qualitySelect = $("quality") as HTMLSelectElement;
  const batchSelect = $("batch") as HTMLSelectElement;
  const ratioSelect = $("ratio") as HTMLSelectElement;
  const jumpWrap = $("jump-wrap") as HTMLElement;
  const jumpCheckbox = $("jump") as HTMLInputElement;
  const jumpFeeEl = jumpWrap.querySelector("[data-jump-fee]") as HTMLElement;
  const refInput = $("ref-image") as HTMLInputElement;
  const refDrop = $("ref-drop") as HTMLElement;
  const refPreview = $("ref-preview") as HTMLElement;
  const refThumb = refPreview.querySelector("img") as HTMLImageElement;
  const refClear = refPreview.querySelector("[data-ref-clear]") as HTMLButtonElement;
  const galleryCheck = $("gallery-check") as HTMLInputElement;
  const queueLine = $("queue-line") as HTMLElement;
  const statusEl = $("status") as HTMLElement;
  const translatedLine = $("translated-line") as HTMLElement;
  const resultGrid = $("result-grid") as HTMLElement;
  const resultEmpty = document.querySelector("[data-result-empty]") as HTMLElement;
  const historyWrap = $("history-section") as HTMLElement;
  const historyEl = $("history") as HTMLElement;

  const history: string[] = [];
  let balance: number | null = null;
  let pointsCost: number | null = null;
  let pointsHd: number | null = null;
  let jumpFee: number | null = null;
  let models: ModelInfo[] = [];
  let selectedModelId: string | null = null;
  let refDataUrl: string | null = null;
  let generating = false;
  let genTimer: number | undefined;

  // 1K/2K 分别计价：清晰度切换时同步更新价格提示
  const renderPrice = () => {
    const hd = qualitySelect.value === "hd";
    const base = pointsCost ?? 0;
    const high = pointsHd ?? base;
    priceValue.textContent = String(hd ? high : base);
    priceHdHint.textContent = hd
      ? "（2K 高清）"
      : high > base
        ? `（2K ${high}）`
        : "";
    priceChip.hidden = false;
  };
  qualitySelect.addEventListener("change", renderPrice);

  const setStatus = (text: string) => {
    statusEl.textContent = text;
  };

  const setBalance = (value: number | null) => {
    if (value === null) return;
    balance = value;
    balanceValue.textContent = String(balance);
    balanceChip.hidden = false;
  };

  const setBadge = (
    state: "online" | "cooldown" | "busy" | "offline" | "checking",
    text: string,
  ) => {
    badge.dataset.state = state;
    badge.textContent = text;
    if (miniStatus) {
      miniStatus.textContent =
        state === "online"
          ? "● 在线"
          : state === "cooldown"
            ? "● 冷却中"
            : state === "busy"
              ? "● 忙碌"
              : "● 检查中";
    }
  };

  const statusLabel: Record<string, string> = {
    ready: "在线",
    cooldown: "冷却中",
    offline: "离线",
    unconfigured: "未配置",
  };

  const adapterIcon: Record<string, string> = {
    "colab-sdxl": "🚀",
    "workers-ai": "⚡",
    "dashscope-images": "🌊",
    "openai-images": "🎨",
    "ark-images": "🌋",
    "bigmodel-image": "✨",
  };

  function renderModels() {
    modelSelect.replaceChildren();
    const usable = models.filter((m) => m.status !== "unconfigured");
    if (!usable.length) {
      modelSelect.hidden = true;
      modelHint.hidden = true;
      setBadge("offline", "● 服务离线");
      setStatus("暂无可用模型，请联系站长配置。");
      return;
    }
    modelSelect.hidden = false;
    if (!models.some((m) => m.id === selectedModelId)) {
      const firstReady = models.find((m) => m.status === "ready");
      selectedModelId = (firstReady ?? usable[0]).id;
    }
    for (const m of models) {
      if (m.status === "unconfigured") continue;
      const opt = document.createElement("option");
      opt.value = m.id;
      opt.textContent = `${adapterIcon[m.adapter] ?? "🎨"} ${m.name} · ${statusLabel[m.status] ?? m.status}`;
      opt.disabled = m.status === "offline";
      opt.selected = m.id === selectedModelId;
      modelSelect.appendChild(opt);
    }
    const current = models.find((m) => m.id === selectedModelId);
    modelHint.hidden = false;
    modelHint.textContent = current
      ? `当前模型 ${current.model}` +
        (current.supportsInitImage ? " · 支持参考图" : " · 不支持参考图（将忽略）") +
        (current.status === "cooldown" ? " · 冷却中，稍后可生成" : "")
      : "";
    updateJumpVisibility();
  }

  modelSelect.addEventListener("change", () => {
    selectedModelId = modelSelect.value;
    renderModels();
    refreshQueue();
  });

  function updateJumpVisibility() {
    const usingColab = selectedModelId === "colab-sdxl";
    jumpWrap.hidden = !usingColab || generating || (jumpFee ?? 0) <= 0;
  }

  async function refreshQueue() {
    if (selectedModelId !== "colab-sdxl") {
      queueLine.hidden = true;
      return;
    }
    try {
      const response = await fetch("/api/ai-image/queue", {
        headers: { Accept: "application/json" },
      });
      const data = (await response.json()) as {
        offline?: boolean;
        busy?: boolean;
        waiting?: number;
        vip?: number;
      };
      const crowded = !data.offline && (data.busy || (data.waiting ?? 0) > 0);
      if (crowded) {
        const vipNote = (data.vip ?? 0) > 0 ? `（含 ${data.vip} 位插队）` : "";
        const jumpPrice =
          (jumpFee ?? 0) > 0 ? ` · 插队 ${jumpFee} 积分可优先` : "";
        queueLine.textContent =
          `🎨 GPU 忙碌中 · 前方排队 ${data.waiting ?? 0} 人${vipNote}${jumpPrice}`;
        queueLine.hidden = false;
      } else {
        queueLine.hidden = true;
      }
      updateJumpVisibility();
    } catch {
      queueLine.hidden = true;
    }
  }

  async function refreshService() {
    try {
      const response = await fetch("/api/ai-image/generate", {
        headers: { Accept: "application/json" },
      });
      const data = (await response.json()) as {
        ok: boolean;
        enabled: boolean;
        points: number;
        pointsHd?: number;
        queueJumpPoints?: number;
        cooldownSeconds?: number;
        models?: ModelInfo[];
      };
      pointsCost = data.points;
      pointsHd =
        typeof data.pointsHd === "number" ? data.pointsHd : data.points;
      renderPrice();
      if (typeof data.queueJumpPoints === "number") {
        jumpFee = data.queueJumpPoints;
        jumpFeeEl.textContent = String(data.queueJumpPoints);
      }
      models = data.models ?? [];
      renderModels();
      void refreshQueue();
      if (!data.enabled) {
        setBadge("busy", "● 生图未开放");
        setStatus("站长暂时关闭了生图功能。");
        return;
      }
      const anyReady = models.some((m) => m.status === "ready");
      const allCooldown =
        models.length > 0 && models.every((m) => m.status === "cooldown");
      if (anyReady) {
        setBadge("online", "● 服务在线");
        setStatus("选择模型，填好提示词，点「开始生成」。");
      } else if (allCooldown && models.length > 0) {
        const secs = data.cooldownSeconds ?? 0;
        setBadge(
          "cooldown",
          `● 冷却中${secs ? `（约 ${Math.ceil(secs / 60)} 分钟）` : ""}`,
        );
        setStatus("模型连续失败进入冷却保护，稍后自动恢复。");
      } else {
        setBadge("busy", "● 服务正忙");
        setStatus("模型暂时都不可用，稍后再来看看（积分不会白扣）。");
      }
    } catch {
      setBadge("busy", "● 服务正忙");
    }
  }

  function addToHistory(url: string) {
    history.push(url);
    historyWrap.hidden = false;
    const img = document.createElement("img");
    img.src = url;
    img.alt = "历史生成";
    img.loading = "lazy";
    img.title = "点击查看原图";
    img.addEventListener("click", () => window.open(url, "_blank"));
    historyEl.prepend(img);
  }

  // ---------- 参考图 ----------
  function setRefImage(dataUrl: string | null) {
    refDataUrl = dataUrl;
    if (dataUrl) {
      refThumb.src = dataUrl;
      refPreview.hidden = false;
      refDrop.hidden = true;
    } else {
      refPreview.hidden = true;
      refDrop.hidden = false;
      refInput.value = "";
    }
  }

  refInput.addEventListener("change", () => {
    const file = refInput.files?.[0];
    if (!file) return;
    if (file.size > 8 * 1024 * 1024) {
      setStatus("参考图过大，请压缩到 8MB 以内。");
      refInput.value = "";
      return;
    }
    const reader = new FileReader();
    reader.onload = () => setRefImage(String(reader.result));
    reader.readAsDataURL(file);
  });

  refClear.addEventListener("click", () => setRefImage(null));

  ["dragover", "dragenter"].forEach((name) =>
    refDrop.addEventListener(name, (e) => {
      e.preventDefault();
      refDrop.style.borderColor = "var(--accent)";
    }),
  );
  ["dragleave", "drop"].forEach((name) =>
    refDrop.addEventListener(name, (e) => {
      e.preventDefault();
      refDrop.style.borderColor = "";
    }),
  );
  refDrop.addEventListener("drop", (e) => {
    const file = e.dataTransfer?.files?.[0];
    if (!file || !/^image\//.test(file.type)) return;
    if (file.size > 8 * 1024 * 1024) {
      setStatus("参考图过大，请压缩到 8MB 以内。");
      return;
    }
    const reader = new FileReader();
    reader.onload = () => setRefImage(String(reader.result));
    reader.readAsDataURL(file);
  });

  // ---------- 批量生成 ----------
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (generating) return;
    const prompt = promptInput.value.trim();
    if (prompt.length < 6) {
      setStatus("主体描述至少 6 个字。");
      return;
    }
    if (!selectedModelId) {
      setStatus("先选择一个模型。");
      return;
    }
    generating = true;
    btn.disabled = true;
    const count = Number(batchSelect.value);
    const usingColab = selectedModelId === "colab-sdxl";
    const startedAt = Date.now();
    genTimer = window.setInterval(() => {
      const elapsed = Math.round((Date.now() - startedAt) / 1000);
      setStatus(
        `🎨 批量生成中… 已等待 ${elapsed} 秒` +
          (usingColab ? "（含排队）" : ""),
      );
    }, 1000);

    resultGrid.replaceChildren();
    resultEmpty?.remove();
    translatedLine.hidden = true;

    const slots: BatchSlot[] = [];
    for (let i = 0; i < count; i += 1) {
      const slot = document.createElement("div");
      slot.className = "ai-result-slot";
      slot.dataset.state = "pending";
      const wrap = document.createElement("div");
      wrap.className = "slot-image-wrap loading";
      wrap.textContent = `第 ${i + 1} 张`;
      const info = document.createElement("div");
      info.className = "slot-info";
      info.textContent = "排队等待…";
      slot.append(wrap, info);
      resultGrid.appendChild(slot);
      slots.push({
        index: i,
        requestId: crypto.randomUUID(),
        el: slot,
        imgWrap: wrap,
        info,
        url: null,
      });
    }

    void refreshQueue();

    const tasks = slots.map((slot) =>
      fetch("/api/ai-image/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({
          requestId: slot.requestId,
          model: selectedModelId,
          prompt,
          prompt_2: prompt2Input.value.trim(),
          negative_prompt: negativeInput.value.trim(),
          quality: qualitySelect.value,
          aspectRatio: ratioSelect.value,
          init_image: refDataUrl ?? undefined,
          jump: usingColab && jumpCheckbox.checked,
        }),
      })
        .then(async (response) => {
          const payload = (await response.json()) as {
            error?: string;
            code?: string;
            balance?: number;
            pointsCost?: number;
            jobId?: string;
            url?: string;
            translated?: string;
            providerName?: string;
            note?: string;
          };
          if (typeof payload.balance === "number") setBalance(payload.balance);
          if (!response.ok || !payload.url) {
            slot.el.dataset.state = "failed";
            slot.imgWrap.classList.remove("loading");
            slot.imgWrap.textContent = "❌";
            slot.info.textContent =
              payload.error?.slice(0, 60) ?? "生成失败（积分已退回）";
            return;
          }
          if (payload.translated && slot.index === 0) {
            translatedLine.textContent = "已翻译为：" + payload.translated;
            translatedLine.hidden = false;
          }
          slot.url = payload.url;
          slot.el.dataset.state = "done";
          slot.imgWrap.classList.remove("loading");
          slot.imgWrap.replaceChildren();
          const img = document.createElement("img");
          img.src = payload.url;
          img.alt = `第 ${slot.index + 1} 张`;
          img.loading = "lazy";
          img.addEventListener("click", () => window.open(payload.url!, "_blank"));
          slot.imgWrap.appendChild(img);
          const actions = document.createElement("div");
          actions.className = "slot-actions";
          const open = document.createElement("a");
          open.href = payload.url;
          open.target = "_blank";
          open.rel = "noopener";
          open.textContent = "原图";
          actions.appendChild(open);
          const upload = document.createElement("button");
          upload.type = "button";
          upload.textContent = galleryCheck.checked ? "上传图库中…" : "上传到图库";
          upload.disabled = Boolean(galleryCheck.checked);
          if (galleryCheck.checked) {
            void uploadToGallery(payload.url!, prompt, slot.index, upload, null);
          } else {
            upload.addEventListener("click", () => {
              upload.disabled = true;
              upload.textContent = "上传中…";
              void uploadToGallery(payload.url!, prompt, slot.index, upload, null);
            });
          }
          const meta = document.createElement("span");
          meta.className = "slot-info";
          meta.textContent =
            `${payload.providerName ?? ""} · ${payload.pointsCost ?? "–"} 积分` +
            (payload.note ? ` · ${payload.note}` : "");
          slot.info.append(meta);
          slot.el.querySelector(".slot-info")?.after(actions);
        })
        .catch(() => {
          slot.el.dataset.state = "failed";
          slot.imgWrap.classList.remove("loading");
          slot.imgWrap.textContent = "❌";
          slot.info.textContent = "网络异常，请稍后重试。";
        }),
    );

    await Promise.allSettled(tasks);
    window.clearInterval(genTimer);
    genTimer = undefined;
    generating = false;
    btn.disabled = false;
    const done = slots.filter((s) => s.url).length;
    setStatus(
      done === count
        ? `✅ 全部完成（${done}/${count}）`
        : `完成 ${done}/${count}，失败部分积分已退回。`,
    );
    void refreshService();
    void refreshQueue();
  });

  async function uploadToGallery(
    url: string,
    prompt: string,
    index: number,
    button?: HTMLButtonElement,
  ) {
    try {
      const blob = await (await fetch(url, { credentials: "same-origin" })).blob();
      const bitmap = await createImageBitmap(blob);
      const variants = new Map<number, Blob>();
      for (const width of [480, 960, 1920]) {
        const canvas = document.createElement("canvas");
        const scale = Math.min(1, width / bitmap.width);
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        const ctx = canvas.getContext("2d");
        ctx?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        const webp = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, "image/webp", 0.86),
        );
        if (webp) variants.set(width, webp);
      }
      const data = new FormData();
      data.append(
        "title",
        (prompt.slice(0, 60) || `AI 生图 · ${new Date().toLocaleDateString("zh-CN")}`) +
          (index > 0 ? ` · ${index + 1}` : ""),
      );
      data.append("width", String(bitmap.width));
      data.append("height", String(bitmap.height));
      data.append("visibility", "public");
      for (const [width, webp] of variants) {
        data.append(`variant-${width}`, webp, `variant-${width}.webp`);
      }
      const response = await fetch("/api/gallery/upload", {
        method: "POST",
        credentials: "same-origin",
        body: data,
      });
      if (!response.ok) {
        const payload = (await response.json().catch(() => null)) as {
          error?: string;
        } | null;
        throw new Error(payload?.error ?? `上传失败（HTTP ${response.status}）`);
      }
      if (button) button.textContent = "已上传到图库 ✓";
      setStatus("已上传到站内图库。");
    } catch (error) {
      if (button) button.disabled = false;
      setStatus(
        error instanceof Error ? error.message : "图库上传失败。",
      );
    }
  }

  // ---------- 初始化 ----------
  async function init() {
    const session = await fetch("/api/auth/get-session", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : null))
      .catch(() => null);

    if (!session?.user) {
      loginCard.hidden = false;
      statusEl.hidden = true;
      return;
    }
    app.hidden = false;

    void fetch("/api/points", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => setBalance(data?.balance ?? null))
      .catch(() => undefined);

    await refreshService();
    window.setInterval(() => void refreshService(), 30_000);
    window.setInterval(() => void refreshQueue(), 5000);
  }

  void init();
</script>
