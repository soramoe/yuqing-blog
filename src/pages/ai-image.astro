---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI 生图"
  description="输入中文提示词，自动翻译成英文后交给站长的 SDXL 模型生成图片。消耗积分。"
>
  <main class="ai-shell">
    <p class="eyebrow">AI IMAGE LAB</p>
    <h1>AI 生图</h1>
    <p class="ai-lead">
      中文会自动翻译成英文，交给站长自建的 SDXL 模型。每次生成消耗积分，生成失败自动退回。
    </p>

    <!-- 未登录：引导登录 -->
    <div id="login-card" class="ai-card" hidden>
      <h2>登录后才能使用</h2>
      <p class="ai-muted">
        生图消耗积分，只有登录用户可以画。登录后每天签到还能攒积分。
      </p>
      <div class="ai-actions">
        <a class="button button-primary" href="/login/">去登录</a>
        <a class="text-link" href="/points/">了解积分 <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <!-- 已登录：主体 -->
    <div id="app" hidden>
      <div class="ai-statusbar">
        <span id="service-badge" class="ai-badge" data-state="checking">
          检查服务…
        </span>
        <span id="balance-chip" class="ai-chip" hidden>
          积分余额 <strong id="balance-value">–</strong>
        </span>
        <span id="price-chip" class="ai-chip" hidden>
          本次消耗 <strong id="price-value">–</strong> 积分
        </span>
      </div>

      <form id="gen-form" class="ai-form">
        <label>
          主体描述（必填）
          <input id="prompt" maxlength="800" placeholder="例如：一只在太空里的橘猫宇航员" required />
        </label>
        <label>
          第二提示词（可选，写给 SDXL 的第二个文本编码器）
          <input id="prompt2" maxlength="800" placeholder="例如：电影感构图，细致的光影层次" />
        </label>
        <label>
          负面提示词（可选，不想出现的东西）
          <input id="negative" maxlength="500" placeholder="例如：模糊，低质量，多余的手指" />
        </label>
        <div class="ai-grid">
          <label>
            画质
            <select id="quality">
              <option value="standard" selected>标准</option>
              <option value="hd">高清</option>
            </select>
          </label>
          <label>
            比例
            <select id="ratio">
              <option value="1:1" selected>1:1 方形</option>
              <option value="4:5">4:5 竖版</option>
              <option value="16:9">16:9 横版</option>
            </select>
          </label>
        </div>
        <button id="submit" class="button button-primary" type="submit">
          生成
        </button>
      </form>

      <p id="status" class="ai-status">正在检查服务状态…</p>
      <p id="translated-line" class="ai-translated" hidden></p>

      <div id="result" class="ai-result" hidden>
        <img id="result-img" alt="生成结果" />
        <p id="result-meta" class="ai-muted"></p>
      </div>

      <div id="history-wrap" hidden>
        <p class="ai-history-title">本次会话的生成记录</p>
        <div id="history" class="ai-history"></div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .ai-shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
  }
  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .ai-lead {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .ai-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 1.6rem;
    display: grid;
    gap: 0.8rem;
  }
  .ai-card h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .ai-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .ai-statusbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }
  .ai-badge,
  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
  }
  .ai-badge[data-state="online"] {
    color: #7ec699;
    border-color: rgb(83 160 112 / 45%);
  }
  .ai-badge[data-state="busy"] {
    color: #e2a355;
    border-color: rgb(205 125 54 / 45%);
  }
  .ai-badge[data-state="cooldown"] {
    color: #e2a355;
    border-color: rgb(205 125 54 / 45%);
  }
  .ai-chip strong {
    color: var(--text);
  }
  .ai-form {
    display: grid;
    gap: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 1.4rem;
    margin-bottom: 1rem;
  }
  .ai-form label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .ai-form input,
  .ai-form select {
    padding: 0.62rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--background);
    color: var(--text);
    font: inherit;
  }
  .ai-form input:focus,
  .ai-form select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .ai-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }
  .ai-form button {
    justify-self: start;
    cursor: pointer;
    min-width: 8rem;
  }
  .ai-form button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .ai-status {
    color: var(--muted);
    min-height: 1.5em;
  }
  .ai-translated {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.6;
    margin-top: -0.4rem;
  }
  .ai-result {
    margin-top: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
  }
  .ai-result img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ai-result p {
    margin: 0;
    padding: 0.7rem 1rem;
    font-size: 0.8rem;
    border-top: 1px solid var(--border);
  }
  .ai-muted {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .ai-history-title {
    margin: 1.6rem 0 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ai-history {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ai-history img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border);
    cursor: pointer;
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id);
  const loginCard = $("login-card") as HTMLElement;
  const app = $("app") as HTMLElement;
  const statusEl = $("status") as HTMLElement;
  const translatedLine = $("translated-line") as HTMLElement;
  const badge = $("service-badge") as HTMLElement;
  const balanceChip = $("balance-chip") as HTMLElement;
  const balanceValue = $("balance-value") as HTMLElement;
  const priceChip = $("price-chip") as HTMLElement;
  const priceValue = $("price-value") as HTMLElement;
  const form = document.getElementById("gen-form") as HTMLFormElement;
  const btn = $("submit") as HTMLButtonElement;
  const promptInput = $("prompt") as HTMLInputElement;
  const prompt2Input = $("prompt2") as HTMLInputElement;
  const negativeInput = $("negative") as HTMLInputElement;
  const qualitySelect = $("quality") as HTMLSelectElement;
  const ratioSelect = $("ratio") as HTMLSelectElement;
  const resultWrap = $("result") as HTMLElement;
  const resultImg = $("result-img") as HTMLImageElement;
  const resultMeta = $("result-meta") as HTMLElement;
  const historyWrap = $("history-wrap") as HTMLElement;
  const historyEl = $("history") as HTMLElement;

  const history: string[] = [];
  let balance: number | null = null;
  let pointsCost: number | null = null;

  const setStatus = (text: string) => {
    statusEl.textContent = text;
  };
  const setBalance = (value: number | null) => {
    if (value === null) return;
    balance = value;
    balanceValue.textContent = String(balance);
    balanceChip.hidden = false;
  };

  function setBadge(state: "online" | "busy" | "checking", text: string) {
    badge.dataset.state = state;
    badge.textContent = text;
  }

  const ERROR_TEXT: Record<string, string> = {
    insufficient: "积分不足啦 — 每日签到可以攒积分。",
    unavailable: "服务正忙（GPU 可能掉线了），积分没有扣。",
    processing: "这个请求正在处理中，别着急。",
    duplicate: "刚才已经提交过一样的请求了。",
  };

  function addToHistory(url: string) {
    history.push(url);
    historyWrap.hidden = false;
    const img = document.createElement("img");
    img.src = url;
    img.alt = "历史生成";
    img.addEventListener("click", () => {
      resultImg.src = url;
      resultWrap.hidden = false;
    });
    historyEl.prepend(img);
  }

  // 1) 登录态：未登录显示登录引导；2) 已登录并行拉取余额与服务状态
  void (async () => {
    const session = await fetch("/api/auth/get-session", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : null))
      .catch(() => null);

    if (!session?.user) {
      loginCard.hidden = false;
      statusEl.hidden = true;
      return;
    }
    app.hidden = false;

    void fetch("/api/points", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => setBalance(data?.balance ?? null))
      .catch(() => undefined);

    // 服务状态：30 秒自动刷新一次，徽章会如实反映 在线/冷却/掉线
    const refreshService = async () => {
      try {
        const response = await fetch("/api/ai-image/generate", {
          headers: { Accept: "application/json" },
        });
        const data = (await response.json()) as {
          ok: boolean;
          enabled: boolean;
          points: number;
          cooldownSeconds?: number;
        };
        pointsCost = data.points;
        priceValue.textContent = String(data.points);
        priceChip.hidden = false;
        if (!data.enabled) {
          setBadge("busy", "● 生图未开放");
          setStatus("站长暂时关闭了生图功能。");
        } else if ((data.cooldownSeconds ?? 0) > 0) {
          const minutes = Math.ceil((data.cooldownSeconds ?? 0) / 60);
          setBadge("cooldown", "● 冷却中");
          setStatus(
            `GPU 刚经历失败，冷却约 ${minutes} 分钟后自动恢复；` +
              "也可以让站长在后台点「重置生图冷却」。",
          );
        } else if (data.ok) {
          setBadge("online", "● 服务在线");
          setStatus("填好提示词，点「生成」开始。");
        } else {
          setBadge("busy", "● 服务正忙");
          setStatus("GPU 服务暂时掉线，稍后再来看看（积分不会白扣）。");
        }
      } catch {
        setBadge("busy", "● 服务正忙");
      }
    };

    await refreshService();
    window.setInterval(() => void refreshService(), 30_000);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const prompt = promptInput.value.trim();
      if (prompt.length < 6) {
        setStatus("主体描述至少 6 个字。");
        return;
      }
      btn.disabled = true;
      setStatus("🎨 翻译 + 生成中，一般 30~60 秒…");
      translatedLine.hidden = true;
      resultWrap.hidden = true;
      try {
        const response = await fetch("/api/ai-image/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({
            requestId: crypto.randomUUID(),
            prompt,
            prompt_2: prompt2Input.value.trim(),
            negative_prompt: negativeInput.value.trim(),
            quality: qualitySelect.value,
            aspectRatio: ratioSelect.value,
          }),
        });
        const data = (await response.json()) as {
          error?: string;
          code?: string;
          balance?: number;
          pointsCost?: number;
          jobId?: string;
          url?: string;
          translated?: string;
        };
        if (response.status === 401) {
          app.hidden = true;
          loginCard.hidden = false;
          return;
        }
        if (!response.ok) {
          setStatus(
            ERROR_TEXT[data.code ?? ""] ??
              data.error ??
              "生成失败，稍后再试。",
          );
          if (typeof data.balance === "number") setBalance(data.balance);
          void refreshService(); // 失败后立刻刷新徽章，让冷却状态可见
          return;
        }
        // 成功
        if (typeof data.balance === "number") setBalance(data.balance);
        if (data.translated) {
          translatedLine.textContent = "已翻译为：" + data.translated;
          translatedLine.hidden = false;
        }
        if (typeof data.url === "string") {
          resultImg.src = data.url;
          resultWrap.hidden = false;
          addToHistory(data.url);
          resultMeta.textContent =
            `消耗 ${data.pointsCost ?? pointsCost ?? "–"} 积分 · ` +
            `余额 ${data.balance ?? "–"} · ${data.width}×${data.height}`;
        }
        setStatus("✅ 完成");
      } catch {
        setStatus("😞 生成失败，稍后再试。");
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>
