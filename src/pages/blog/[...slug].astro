---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import {
  formatDate,
  getPublishedPosts,
  getReadingTime,
} from "../../lib/blog";
import { getResponsiveImage } from "../../lib/images";
import { SITE } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const allPosts = await getPublishedPosts();
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const titleParts = post.data.title.split("：");
const titleLead = titleParts.length > 1 ? `${titleParts[0]}：` : "";
const titleRest = titleParts.slice(1).join("：");
const coverWidths = post.data.cover?.startsWith("/gallery/")
  ? [480, 960, 1920]
  : [480, 960, 1440];
const cover = post.data.cover
  ? getResponsiveImage(post.data.cover, coverWidths)
  : null;
const relatedPosts = allPosts
  .filter((item) => item.id !== post.id)
  .sort((a, b) => {
    const categoryDifference =
      Number(b.data.category === post.data.category) -
      Number(a.data.category === post.data.category);
    return (
      categoryDifference ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
      a.id.localeCompare(b.id)
    );
  })
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover?.variants.at(-1) ?? post.data.cover}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  section={post.data.category}
  keywords={post.data.tags}
>
  <article class="container article-page" data-pagefind-body>
    <header class="article-header">
      <div class="article-topline">
        <span>分类 / {post.data.category}</span>
        <div class="tag-list" aria-label="文章标签">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag">#{tag}</a>
          ))}
        </div>
      </div>

      <h1>
        {
          titleLead ? (
            <>
              <span class="title-part">{titleLead}</span>
              <span class="title-part">{titleRest}</span>
            </>
          ) : (
            post.data.title
          )
        }
      </h1>

      <p class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        <span>{SITE.author.name}</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>{getReadingTime(post.body)} MIN READ</span>
        {post.data.updatedDate && (
          <span>更新于 {formatDate(post.data.updatedDate)}</span>
        )}
      </div>
      {
        cover && (
          <figure class="article-cover">
            <img
              src={cover.src}
              srcset={cover.srcSet}
              sizes="(max-width: 820px) calc(100vw - 32px), 960px"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }
    </header>

    <div class="article-grid">
      <aside class="article-aside">
        <section class="article-author">
          <span class="author-mark" aria-hidden="true">小</span>
          <div>
            <strong>{SITE.author.name}</strong>
            <p>{SITE.author.bio}</p>
          </div>
        </section>

        <nav class="article-toc" aria-label="文章目录">
          <p>ON THIS PAGE</p>
          {tocHeadings.length > 0 ? (
            <ol>
              {tocHeadings.map((heading) => (
                <li class:list={{ nested: heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          ) : (
            <span>暂无小节</span>
          )}
        </nav>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="related-posts" aria-labelledby="related-title">
          <div class="related-heading">
            <p class="eyebrow">CONTINUE READING</p>
            <h2 id="related-title">继续阅读</h2>
          </div>
          <div class="related-grid">
            {relatedPosts.map((item) => (
              <a href={`/blog/${item.id}/`}>
                <span>{item.data.category}</span>
                <strong>{item.data.title}</strong>
                <small>{formatDate(item.data.pubDate)} · {getReadingTime(item.body)} MIN</small>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <Comments postSlug={post.id} />
  </article>
</BaseLayout>
