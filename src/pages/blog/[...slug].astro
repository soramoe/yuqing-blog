---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import {
  formatDate,
  getPublishedPosts,
  getReadingTime,
} from "../../lib/blog";
import { SITE } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const currentIndex = posts.findIndex((item) => item.id === post.id);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < posts.length - 1
    ? posts[currentIndex + 1]
    : undefined;
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
>
  <article class="container article-shell" data-pagefind-body>
    <header class="article-header">
      <div class="tag-list">
        {post.data.tags.map((tag) => (
          <a href={`/tags/${tag}/`} class="tag">#{tag}</a>
        ))}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span aria-hidden="true">/</span>
        <span>作者：{SITE.author.name}</span>
        <span aria-hidden="true">/</span>
        <span>{getReadingTime(post.body)} 分钟阅读</span>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">/</span>
            <span>更新于 {formatDate(post.data.updatedDate)}</span>
          </>
        )}
      </div>
    </header>

    <div class="article-layout">
      <aside class="article-toc" aria-label="文章目录">
        <p>本文目录</p>
        {tocHeadings.length > 0 ? (
          <ol>
            {tocHeadings.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        ) : (
          <span>暂无小节</span>
        )}
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="post-navigation" aria-label="相邻文章">
      <div>
        {olderPost && (
          <a href={`/blog/${olderPost.id}/`}>
            <span>上一篇</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        )}
      </div>
      <div class="post-navigation-next">
        {newerPost && (
          <a href={`/blog/${newerPost.id}/`}>
            <span>下一篇</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        )}
      </div>
    </nav>

    <Comments />
  </article>
</BaseLayout>
