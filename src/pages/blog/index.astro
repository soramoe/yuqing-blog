---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/blog";
import { SITE } from "../../site.config";

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description={`${SITE.name}的全部文章归档。`}>
  <section class="container page-heading">
    <p class="eyebrow">ALL WRITING</p>
    <h1>文章归档</h1>
    <p>技术、写作与生活里那些值得认真对待的问题。</p>
  </section>

  <section class="container archive-list">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </section>
</BaseLayout>
