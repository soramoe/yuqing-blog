---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import "../../styles/admin-story.css";
---

<BaseLayout
  title="生图管理"
  description="生图开关、AI 生图 1K/2K 定价、互动小说插画定价与配额管理。"
  bodyClass="page-admin-image"
  noindex
>
  <div class="container admin-story-shell">
    <header class="admin-story-header">
      <div>
        <p class="eyebrow">IMAGE OPERATIONS</p>
        <h1>生图管理</h1>
        <p>开关、AI 生图 1K/2K 定价、互动小说插画定价与限额。模型与 API 绑定在「AI 配置」页。</p>
      </div>
    </header>

    <AdminNav />

    <p class="admin-story-status" data-image-admin-status aria-live="polite">
      正在验证权限…
    </p>

    <div class="admin-story-denied" data-image-admin-gate hidden>
      <p class="eyebrow">ACCESS REQUIRED</p>
      <strong data-image-gate-title>请先登录</strong>
      <p data-image-gate-copy>登录站长账号后才能管理生图。</p>
      <a href="/login/?next=%2Fadmin%2Fimage%2F" data-image-gate-link>
        登录站长账号
      </a>
    </div>

    <div class="admin-story-content" data-image-admin-content hidden>
      <section class="admin-story-settings">
        <div class="admin-story-section-heading">
          <div>
            <p class="eyebrow">IMAGE CONTROL</p>
            <h2>生图控制</h2>
          </div>
          <span data-image-config-status>正在读取…</span>
        </div>
        <form data-image-config-form>
          <h3 class="admin-image-section-title">开关</h3>
          <label class="admin-story-toggle admin-image-master-toggle">
            <input type="checkbox" data-image-enabled />
            <span>
              <strong>开放生图能力</strong>
              <small>总开关关闭时，所有生图功能（含互动小说插画）都不会调用图片模型。</small>
            </span>
          </label>
          <label class="admin-story-toggle">
            <input type="checkbox" data-image-story-enabled />
            <span>
              <strong>互动小说生图</strong>
              <small>独立开关：关闭后互动小说不再生成章节插画，但「AI 生图」页面不受影响；需总开关同时开启。</small>
            </span>
          </label>

          <h3 class="admin-image-section-title">「AI 生图」定价</h3>
          <label>
            <span>1K 积分</span>
            <input type="number" min="1" max="10000" data-image-studio-points required />
            <small>「AI 生图」页面选择 1K 标准时的单张价格。</small>
          </label>
          <label>
            <span>2K 积分</span>
            <input type="number" min="1" max="10000" data-image-studio-hd-points required />
            <small>选择 2K 高清时的单张价格；自动比例也会按该清晰度出图。</small>
          </label>
          <h3 class="admin-image-section-title">互动小说插画定价</h3>
          <label>
            <span>1K 积分（标准图）</span>
            <input type="number" min="1" max="1000" data-image-standard-points required />
            <small>互动小说章节插画的 1K 单张价格。</small>
          </label>
          <label>
            <span>2K 积分（高清图）</span>
            <input type="number" min="1" max="1000" data-image-hd-points required />
            <small>互动小说章节插画的 2K 单张价格。</small>
          </label>

          <h3 class="admin-image-section-title">限额与预算</h3>
          <label>
            <span>每日全站任务上限</span>
            <input type="number" min="1" max="5000" data-image-daily-limit required />
            <small>达到上限后自动停止新任务。</small>
          </label>
          <label>
            <span>每月全站预算（元）</span>
            <input type="number" min="0" max="10000" data-image-monthly-budget required />
            <small>只统计付费供应商的保守成本。</small>
          </label>

          <div class="admin-story-form-actions">
            <button type="button" data-image-cooldown-reset>重置模型冷却</button>
            <button type="submit" data-image-config-submit>保存设置</button>
          </div>
          <p data-image-config-message aria-live="polite"></p>
        </form>
        <p class="admin-story-empty">
          模型与 API 绑定、实时消耗监控在
          <a href="/admin/ai-config/">AI 配置</a>
          页面管理。
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { authClient } from "../../lib/auth-client";

  interface AdminImageConfig {
    enabled: boolean;
    storyEnabled: boolean;
    standardPoints: number;
    hdPoints: number;
    studioPoints: number;
    studioHdPoints: number;
    dailyJobLimit: number;
    monthlyBudgetCents: number;
  }

  const status = document.querySelector<HTMLElement>(
    "[data-image-admin-status]",
  );
  const gate = document.querySelector<HTMLElement>("[data-image-admin-gate]");
  const content = document.querySelector<HTMLElement>(
    "[data-image-admin-content]",
  );
  const gateTitle = document.querySelector<HTMLElement>(
    "[data-image-gate-title]",
  );
  const gateCopy = document.querySelector<HTMLElement>(
    "[data-image-gate-copy]",
  );
  const gateLink = document.querySelector<HTMLAnchorElement>(
    "[data-image-gate-link]",
  );
  const imageConfigForm = document.querySelector<HTMLFormElement>(
    "[data-image-config-form]",
  );
  const imageEnabledInput = document.querySelector<HTMLInputElement>(
    "[data-image-enabled]",
  );
  const imageStoryEnabledInput = document.querySelector<HTMLInputElement>(
    "[data-image-story-enabled]",
  );
  const imageStandardInput = document.querySelector<HTMLInputElement>(
    "[data-image-standard-points]",
  );
  const imageHdInput = document.querySelector<HTMLInputElement>(
    "[data-image-hd-points]",
  );
  const imageStudioInput = document.querySelector<HTMLInputElement>(
    "[data-image-studio-points]",
  );
  const imageStudioHdInput = document.querySelector<HTMLInputElement>(
    "[data-image-studio-hd-points]",
  );
  const imageDailyInput = document.querySelector<HTMLInputElement>(
    "[data-image-daily-limit]",
  );
  const imageBudgetInput = document.querySelector<HTMLInputElement>(
    "[data-image-monthly-budget]",
  );
  const imageConfigSubmit = document.querySelector<HTMLButtonElement>(
    "[data-image-config-submit]",
  );
  const imageConfigStatus = document.querySelector<HTMLElement>(
    "[data-image-config-status]",
  );
  const imageConfigMessage = document.querySelector<HTMLElement>(
    "[data-image-config-message]",
  );
  const imageCooldownReset = document.querySelector<HTMLButtonElement>(
    "[data-image-cooldown-reset]",
  );

  const setImageConfigMessage = (
    message = "",
    state: "idle" | "error" | "success" = "idle",
  ) => {
    if (!imageConfigMessage) return;
    imageConfigMessage.textContent = message;
    imageConfigMessage.dataset.state = state;
  };

  const fillImageConfig = (settings: AdminImageConfig) => {
    if (imageEnabledInput) imageEnabledInput.checked = settings.enabled;
    if (imageStoryEnabledInput) {
      imageStoryEnabledInput.checked = settings.storyEnabled;
      imageStoryEnabledInput.disabled = !settings.enabled;
    }
    if (imageStandardInput) {
      imageStandardInput.value = String(settings.standardPoints);
    }
    if (imageHdInput) imageHdInput.value = String(settings.hdPoints);
    if (imageStudioInput) {
      imageStudioInput.value = String(settings.studioPoints);
    }
    if (imageStudioHdInput) {
      imageStudioHdInput.value = String(settings.studioHdPoints);
    }
    if (imageDailyInput) {
      imageDailyInput.value = String(settings.dailyJobLimit);
    }
    if (imageBudgetInput) {
      imageBudgetInput.value = String(settings.monthlyBudgetCents / 100);
    }
    if (imageConfigStatus) {
      imageConfigStatus.textContent = settings.enabled
        ? settings.storyEnabled
          ? "生图已开启"
          : "生图已开启（小说插画关闭）"
        : "生图已关闭";
    }
  };

  // 总开关关闭时，小说插画开关不可单独操作
  imageEnabledInput?.addEventListener("change", () => {
    if (imageStoryEnabledInput) {
      imageStoryEnabledInput.disabled = !imageEnabledInput.checked;
    }
  });

  const loadImageConfig = async () => {
    const response = await fetch("/api/admin/image", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    });
    if (response.status === 401 || response.status === 403) {
      const requestError = new Error("权限校验失败。") as Error & {
        status?: number;
      };
      requestError.status = response.status;
      throw requestError;
    }
    const payload = (await response.json()) as {
      settings?: AdminImageConfig;
      error?: string;
    };
    if (!payload.settings) {
      throw new Error(payload.error || "生图设置读取失败。");
    }
    fillImageConfig(payload.settings);
  };

  // 供应商连续失败进入冷却后，可一键清零立刻恢复可用
  imageCooldownReset?.addEventListener("click", async () => {
    if (!imageCooldownReset) return;
    imageCooldownReset.disabled = true;
    setImageConfigMessage("正在重置生图服务冷却…");
    try {
      const response = await fetch("/api/admin/image/cooldown", {
        method: "POST",
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      const payload = (await response.json()) as { error?: string };
      if (!response.ok) {
        throw new Error(payload.error || "重置失败。");
      }
      setImageConfigMessage("生图服务冷却已重置，可以立即重新生图。", "success");
    } catch (error) {
      setImageConfigMessage(
        error instanceof Error ? error.message : "重置失败，请稍后重试。",
        "error",
      );
    } finally {
      imageCooldownReset.disabled = false;
    }
  });

  imageConfigForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!imageConfigSubmit) return;
    imageConfigSubmit.disabled = true;
    setImageConfigMessage("正在保存生图控制…");
    try {
      const response = await fetch("/api/admin/image", {
        method: "PATCH",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          settings: {
            enabled: imageEnabledInput?.checked ?? false,
            storyEnabled: imageStoryEnabledInput?.checked ?? true,
            standardPoints: Number(imageStandardInput?.value),
            hdPoints: Number(imageHdInput?.value),
            studioPoints: Number(imageStudioInput?.value),
            studioHdPoints: Number(imageStudioHdInput?.value),
            dailyJobLimit: Number(imageDailyInput?.value),
            monthlyBudgetCents: Math.round(
              Number(imageBudgetInput?.value ?? 0) * 100,
            ),
          },
        }),
      });
      const payload = (await response.json()) as {
        settings?: AdminImageConfig;
        error?: string;
      };
      if (!response.ok || !payload.settings) {
        throw new Error(payload.error || "生图控制保存失败。");
      }
      fillImageConfig(payload.settings);
      setImageConfigMessage("生图控制已保存。", "success");
    } catch (error) {
      setImageConfigMessage(
        error instanceof Error ? error.message : "生图控制保存失败。",
        "error",
      );
    } finally {
      imageConfigSubmit.disabled = false;
    }
  });

  void authClient
    .getSession()
    .then(async ({ data }) => {
      if (!data?.user) {
        if (gateTitle) gateTitle.textContent = "请先登录";
        if (gateCopy) gateCopy.textContent = "登录站长账号后才能管理生图。";
        if (status) status.hidden = true;
        gate?.removeAttribute("hidden");
        return;
      }
      try {
        await loadImageConfig();
        if (status) status.hidden = true;
        gate?.setAttribute("hidden", "");
        content?.removeAttribute("hidden");
      } catch (error) {
        const requestError = error as Error & { status?: number };
        if (requestError.status === 403) {
          if (gateTitle) gateTitle.textContent = "没有管理权限";
          if (gateCopy) gateCopy.textContent = "当前账号不是站长。";
        } else if (requestError.status === 401) {
          if (gateTitle) gateTitle.textContent = "登录已过期";
          if (gateCopy) gateCopy.textContent = "请重新登录后再试。";
        } else {
          if (gateTitle) gateTitle.textContent = "暂时无法读取设置";
          if (gateCopy) {
            gateCopy.textContent =
              error instanceof Error ? error.message : "请稍后重试。";
          }
          if (gateLink) gateLink.hidden = true;
        }
        if (status) status.hidden = true;
        gate?.removeAttribute("hidden");
      }
    })
    .catch(() => {
      if (gateTitle) gateTitle.textContent = "无法验证登录状态";
      if (gateCopy) gateCopy.textContent = "请刷新页面后重试。";
      gate?.removeAttribute("hidden");
    });
</script>
