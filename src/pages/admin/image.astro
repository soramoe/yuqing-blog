---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import "../../styles/admin-story.css";
---

<BaseLayout
  title="生图管理"
  description="管理全站生图开关、积分定价、供应商优先级与冷却重置。"
  bodyClass="page-admin-image"
  noindex
>
  <div class="container admin-story-shell">
    <header class="admin-story-header">
      <div>
        <p class="eyebrow">AI IMAGE OPERATIONS</p>
        <h1>生图管理</h1>
        <p>生图总开关、各类积分定价、供应商优先级与冷却重置。保存后立即生效。</p>
      </div>
    </header>

    <AdminNav />

    <p class="admin-story-status" data-image-admin-status aria-live="polite">
      正在验证权限…
    </p>

    <div class="admin-story-denied" data-image-admin-gate hidden>
      <p class="eyebrow">ACCESS REQUIRED</p>
      <strong data-image-gate-title>请先登录</strong>
      <p data-image-gate-copy>登录站长账号后才能管理生图。</p>
      <a href="/login/?next=%2Fadmin%2Fimage%2F" data-image-gate-link>
        登录站长账号
      </a>
    </div>

    <div class="admin-story-content" data-image-admin-content hidden>
      <section class="admin-story-settings admin-image-control-panel">
        <div class="admin-story-section-heading">
          <div>
            <p class="eyebrow">IMAGE CONTROL</p>
            <h2>生图控制</h2>
          </div>
          <span data-image-config-status>正在读取…</span>
        </div>
        <form data-image-config-form>
          <label class="admin-story-toggle admin-image-master-toggle">
            <input type="checkbox" data-image-enabled />
            <span>
              <strong>开放生图能力</strong>
              <small>总开关关闭时，管理员测试也不会调用图片模型。</small>
            </span>
          </label>
          <label>
            <span>标准图积分</span>
            <input type="number" min="1" max="1000" data-image-standard-points required />
            <small>互动小说章节插画的标准图价格，推荐 20 积分。</small>
          </label>
          <label>
            <span>高清图积分</span>
            <input type="number" min="1" max="1000" data-image-hd-points required />
            <small>互动小说章节插画的高清图价格，推荐 32 积分。</small>
          </label>
          <label>
            <span>AI 生图积分（Colab SDXL）</span>
            <input type="number" min="1" max="10000" data-image-studio-points required />
            <small>「AI 生图」页面每次生成的消耗，走站长自己的 Colab GPU。</small>
          </label>
          <label>
            <span>插队积分</span>
            <input type="number" min="0" max="10000" data-image-jump-points required />
            <small>有人在生图时，其他用户可付此积分插队；0 = 关闭插队。生成失败自动退回。</small>
          </label>
          <label>
            <span>每日全站任务上限</span>
            <input type="number" min="1" max="5000" data-image-daily-limit required />
            <small>达到上限后自动停止新任务。</small>
          </label>
          <label>
            <span>每月全站预算（元）</span>
            <input type="number" min="0" max="10000" data-image-monthly-budget required />
            <small>只统计付费供应商的保守成本。</small>
          </label>
          <div class="admin-image-provider-list" data-image-provider-list></div>
          <div class="admin-story-form-actions">
            <button type="submit" data-image-config-submit>保存生图控制</button>
            <button type="button" data-image-cooldown-reset>重置生图冷却</button>
          </div>
          <p data-image-config-message aria-live="polite"></p>
        </form>
      </section>

      <section class="admin-story-settings admin-usage-panel">
        <div class="admin-story-section-heading">
          <div>
            <p class="eyebrow">USAGE ANALYTICS</p>
            <h2>用量数据</h2>
          </div>
          <span>今日 / 本月累计</span>
        </div>
        <div class="usage-cards">
          <div class="usage-card">
            <strong data-usage-today-jobs>–</strong>
            <span>今日任务</span>
          </div>
          <div class="usage-card">
            <strong data-usage-today-ok>–</strong>
            <span>今日成功</span>
          </div>
          <div class="usage-card">
            <strong data-usage-today-fail>–</strong>
            <span>今日失败</span>
          </div>
        </div>
        <p class="usage-bar-title">各供应商累计（全部周期合并）</p>
        <div class="usage-bars" data-usage-bars></div>
      </section>

      <section class="admin-story-settings admin-recent-panel">
        <div class="admin-story-section-heading">
          <div>
            <p class="eyebrow">LIVE CALLS</p>
            <h2>最近调用（实时）</h2>
          </div>
          <span data-usage-updated>–</span>
        </div>
        <table class="recent-attempts-table">
          <thead>
            <tr><th>时间</th><th>供应商</th><th>模型</th><th>结果</th><th>耗时</th></tr>
          </thead>
          <tbody data-recent-attempts></tbody>
        </table>
      </section>

      <section class="admin-story-settings admin-image-test-panel">
        <div class="admin-story-section-heading">
          <div>
            <p class="eyebrow">IMAGE PROVIDER TEST</p>
            <h2>生图模型测试</h2>
          </div>
          <span>仅管理员可见</span>
        </div>
        <form data-image-test-form>
          <label>
            <span>测试提示词</span>
            <textarea
              rows="3"
              maxlength="1000"
              data-image-test-prompt
              required
            >雨夜中的中式旧城，一名撑伞的旅人站在河桥边，电影感，水墨与霓虹交织，无文字</textarea>
            <small>会按后台供应商顺序调用，并产生一次测试任务。</small>
          </label>
          <label>
            <span>图片质量</span>
            <select data-image-test-quality>
              <option value="standard">标准图</option>
              <option value="hd">高清图</option>
            </select>
            <small>测试任务按对应档位计价，从站长余额扣除。</small>
          </label>
          <div class="admin-story-form-actions">
            <button type="submit" data-image-test-submit>开始测试</button>
          </div>
          <p data-image-test-status aria-live="polite"></p>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .admin-story-header {
    margin-bottom: 0.6rem;
  }
</style>

<script>
  import { authClient } from "../../lib/auth-client";

  interface AdminImageProvider {
    id: string;
    name: string;
    adapter: string;
    model: string;
    features: string;
    baseUrl: string;
    enabled: boolean;
    priority: number;
    configured: boolean;
    cooldownActive: boolean;
    hasApiKey: boolean;
    apiKeyMasked: string;
  }

  interface AdminImageConfig {
    enabled: boolean;
    standardPoints: number;
    hdPoints: number;
    studioPoints: number;
    queueJumpPoints: number;
    dailyJobLimit: number;
    monthlyBudgetCents: number;
  }

  const status = document.querySelector<HTMLElement>(
    "[data-image-admin-status]",
  );
  const gate = document.querySelector<HTMLElement>("[data-image-admin-gate]");
  const content = document.querySelector<HTMLElement>(
    "[data-image-admin-content]",
  );
  const gateTitle = document.querySelector<HTMLElement>(
    "[data-image-gate-title]",
  );
  const gateCopy = document.querySelector<HTMLElement>(
    "[data-image-gate-copy]",
  );
  const gateLink = document.querySelector<HTMLAnchorElement>(
    "[data-image-gate-link]",
  );
  const imageConfigForm = document.querySelector<HTMLFormElement>(
    "[data-image-config-form]",
  );
  const imageEnabledInput = document.querySelector<HTMLInputElement>(
    "[data-image-enabled]",
  );
  const imageStandardInput = document.querySelector<HTMLInputElement>(
    "[data-image-standard-points]",
  );
  const imageHdInput = document.querySelector<HTMLInputElement>(
    "[data-image-hd-points]",
  );
  const imageStudioInput = document.querySelector<HTMLInputElement>(
    "[data-image-studio-points]",
  );
  const imageJumpInput = document.querySelector<HTMLInputElement>(
    "[data-image-jump-points]",
  );
  const imageDailyInput = document.querySelector<HTMLInputElement>(
    "[data-image-daily-limit]",
  );
  const imageBudgetInput = document.querySelector<HTMLInputElement>(
    "[data-image-monthly-budget]",
  );
  const imageProviderList = document.querySelector<HTMLElement>(
    "[data-image-provider-list]",
  );
  const imageConfigSubmit = document.querySelector<HTMLButtonElement>(
    "[data-image-config-submit]",
  );
  const imageConfigStatus = document.querySelector<HTMLElement>(
    "[data-image-config-status]",
  );
  const imageConfigMessage = document.querySelector<HTMLElement>(
    "[data-image-config-message]",
  );
  const imageCooldownReset = document.querySelector<HTMLButtonElement>(
    "[data-image-cooldown-reset]",
  );
  const imageTestForm = document.querySelector<HTMLFormElement>(
    "[data-image-test-form]",
  );
  const imageTestPrompt = document.querySelector<HTMLTextAreaElement>(
    "[data-image-test-prompt]",
  );
  const imageTestQuality = document.querySelector<HTMLSelectElement>(
    "[data-image-test-quality]",
  );
  const imageTestSubmit = document.querySelector<HTMLButtonElement>(
    "[data-image-test-submit]",
  );
  const imageTestStatus = document.querySelector<HTMLElement>(
    "[data-image-test-status]",
  );
  let imageConfigProviders: AdminImageProvider[] = [];

  interface UsageRow {
    providerId: string;
    period: string;
    jobs: number;
    successes: number;
    failures: number;
    spentCents: number;
  }

  interface UsageToday {
    jobs: number;
    succeeded: number;
    failed: number;
    byProvider: Array<{
      providerId: string;
      attempts: number;
      succeeded: number;
      failed: number;
    }>;
  }

  interface RecentAttempt {
    providerId: string;
    providerName: string | null;
    model: string | null;
    status: string;
    errorCode: string | null;
    errorMessage: string | null;
    durationMs: number;
    createdAt: number;
  }

  const setImageConfigMessage = (
    message = "",
    state: "idle" | "error" | "success" = "idle",
  ) => {
    if (!imageConfigMessage) return;
    imageConfigMessage.textContent = message;
    imageConfigMessage.dataset.state = state;
  };

  const renderImageProviders = () => {
    if (!imageProviderList) return;
    imageProviderList.replaceChildren();
    for (const provider of imageConfigProviders) {
      const card = document.createElement("article");
      card.className = "admin-image-provider";
      card.dataset.imageProviderId = provider.id;

      const heading = document.createElement("header");
      const active = document.createElement("label");
      active.className = "admin-image-provider-toggle";
      const enabled = document.createElement("input");
      enabled.type = "checkbox";
      enabled.checked = provider.enabled;
      enabled.dataset.imageProviderEnabled = "";
      const name = document.createElement("span");
      const strong = document.createElement("strong");
      strong.textContent = provider.name;
      const state = document.createElement("small");
      state.textContent = provider.configured
        ? provider.cooldownActive
          ? "冷却中"
          : "已配置"
        : "缺少密钥";
      state.dataset.configured = String(provider.configured);
      name.append(strong, state);
      active.append(enabled, name);
      heading.append(active);

      const fields = document.createElement("div");
      fields.className = "admin-image-provider-fields";
      const modelLabel = document.createElement("label");
      const modelSpan = document.createElement("span");
      modelSpan.textContent = "模型";
      const modelInput = document.createElement("input");
      modelInput.type = "text";
      modelInput.maxLength = 160;
      modelInput.value = provider.model;
      modelInput.dataset.imageProviderModel = "";
      modelLabel.append(modelSpan, modelInput);

      const priorityLabel = document.createElement("label");
      const prioritySpan = document.createElement("span");
      prioritySpan.textContent = "优先级";
      const priorityInput = document.createElement("input");
      priorityInput.type = "number";
      priorityInput.min = "0";
      priorityInput.max = "10000";
      priorityInput.value = String(provider.priority);
      priorityInput.dataset.imageProviderPriority = "";
      priorityLabel.append(prioritySpan, priorityInput);

      // API 绑定：仅云端适配器需要密钥；Colab 走隧道、Workers AI 走绑定
      if (
        provider.adapter === "dashscope-images" ||
        provider.adapter === "openai-images"
      ) {
        const keyLabel = document.createElement("label");
        const keySpan = document.createElement("span");
        keySpan.textContent = "API 密钥绑定";
        const keyInput = document.createElement("input");
        keyInput.type = "password";
        keyInput.maxLength = 300;
        keyInput.placeholder = provider.hasApiKey
          ? `已绑定（${provider.apiKeyMasked}），留空保持不变`
          : "未绑定，粘贴该服务商的密钥";
        keyInput.dataset.imageProviderKey = "";
        keyLabel.append(keySpan, keyInput);

        const urlLabel = document.createElement("label");
        const urlSpan = document.createElement("span");
        urlSpan.textContent = "接入地址（可选）";
        const urlInput = document.createElement("input");
        urlInput.type = "text";
        urlInput.maxLength = 300;
        urlInput.value = provider.baseUrl ?? "";
        urlInput.placeholder = "留空使用官方默认地址";
        urlInput.dataset.imageProviderBaseurl = "";
        urlLabel.append(urlSpan, urlInput);
        fields.append(keyLabel, urlLabel);
      }

      fields.append(modelLabel, priorityLabel);
      card.append(heading, fields);
      imageProviderList.append(card);
    }
  };

  const renderUsage = (
    today: UsageToday | null,
    usage: UsageRow[],
    providers: AdminImageProvider[],
  ) => {
    const set = (selector: string, value: number) => {
      const el = document.querySelector<HTMLElement>(selector);
      if (el) el.textContent = String(value);
    };
    set("[data-usage-today-jobs]", today?.jobs ?? 0);
    set("[data-usage-today-ok]", today?.succeeded ?? 0);
    set("[data-usage-today-fail]", today?.failed ?? 0);

    const bars = document.querySelector("[data-usage-bars]");
    if (!bars) return;
    bars.replaceChildren();
    const nameOf = (id: string) =>
      providers.find((p) => p.id === id)?.name ?? id;
    const byProvider = new Map<
      string,
      { jobs: number; ok: number; fail: number; spent: number }
    >();
    for (const row of usage) {
      const cur = byProvider.get(row.providerId) ?? {
        jobs: 0,
        ok: 0,
        fail: 0,
        spent: 0,
      };
      cur.jobs += row.jobs;
      cur.ok += row.successes;
      cur.fail += row.failures;
      cur.spent += row.spentCents;
      byProvider.set(row.providerId, cur);
    }
    const entries = Array.from(byProvider.entries()).sort(
      (a, b) => b[1].jobs - a[1].jobs,
    );
    const maxJobs = Math.max(1, ...entries.map(([, v]) => v.jobs));
    for (const [id, v] of entries) {
      const row = document.createElement("div");
      row.className = "usage-bar-row";
      const label = document.createElement("span");
      label.className = "usage-bar-label";
      label.textContent = nameOf(id);
      const track = document.createElement("div");
      track.className = "usage-bar-track";
      const fill = document.createElement("div");
      fill.className = "usage-bar-fill";
      fill.style.width = `${Math.round((v.jobs / maxJobs) * 100)}%`;
      track.appendChild(fill);
      const num = document.createElement("span");
      num.className = "usage-bar-num";
      num.textContent = `${v.jobs} 次 · 成功 ${v.ok} · 失败 ${v.fail}`;
      row.append(label, track, num);
      bars.appendChild(row);
    }
  };

  const renderRecentAttempts = (rows: RecentAttempt[]) => {
    const table = document.querySelector("[data-recent-attempts]");
    if (!table) return;
    table.replaceChildren();
    if (!rows.length) {
      const empty = document.createElement("tr");
      const cell = document.createElement("td");
      cell.colSpan = 5;
      cell.textContent = "还没有调用记录。";
      empty.appendChild(cell);
      table.appendChild(empty);
      return;
    }
    for (const row of rows) {
      const tr = document.createElement("tr");
      tr.className = "recent-row " + (row.status === "succeeded" ? "ok" : "bad");
      const time = document.createElement("td");
      time.textContent = new Date(row.createdAt).toLocaleString("zh-CN");
      const provider = document.createElement("td");
      provider.textContent = row.providerName ?? row.providerId;
      const model = document.createElement("td");
      model.textContent = row.model ?? "–";
      const state = document.createElement("td");
      state.textContent =
        row.status === "succeeded"
          ? "✅ 成功"
          : `❌ ${(row.errorMessage ?? "失败").slice(0, 50)}`;
      const duration = document.createElement("td");
      duration.textContent = `${(row.durationMs / 1000).toFixed(1)}s`;
      tr.append(time, provider, model, state, duration);
      table.appendChild(tr);
    }
  };

  const fillImageConfig = (
    settings: AdminImageConfig,
    providers: AdminImageProvider[],
    today?: UsageToday | null,
    usage?: UsageRow[],
    recentAttempts?: RecentAttempt[],
  ) => {
    imageConfigProviders = providers;
    if (imageEnabledInput) imageEnabledInput.checked = settings.enabled;
    if (imageStandardInput) {
      imageStandardInput.value = String(settings.standardPoints);
    }
    if (imageHdInput) imageHdInput.value = String(settings.hdPoints);
    if (imageStudioInput) {
      imageStudioInput.value = String(settings.studioPoints);
    }
    if (imageJumpInput) {
      imageJumpInput.value = String(settings.queueJumpPoints);
    }
    if (imageDailyInput) {
      imageDailyInput.value = String(settings.dailyJobLimit);
    }
    if (imageBudgetInput) {
      imageBudgetInput.value = String(settings.monthlyBudgetCents / 100);
    }
    if (imageConfigStatus) {
      imageConfigStatus.textContent = settings.enabled ? "生图已开启" : "生图已关闭";
    }
    renderImageProviders();
    renderUsage(today ?? null, usage ?? [], providers);
    renderRecentAttempts(recentAttempts ?? []);
  };

  // Colab 重启恢复后，清零所有图片供应商的失败计数与冷却锁，立刻恢复可用
  imageCooldownReset?.addEventListener("click", async () => {
    if (!imageCooldownReset) return;
    imageCooldownReset.disabled = true;
    setImageConfigMessage("正在重置生图服务冷却…");
    try {
      const response = await fetch("/api/admin/image/cooldown", {
        method: "POST",
        credentials: "same-origin",
        headers: { Accept: "application/json" },
      });
      const payload = (await response.json()) as { error?: string };
      if (!response.ok) {
        throw new Error(payload.error || "重置失败。");
      }
      setImageConfigMessage("生图服务冷却已重置，可以立即重新生图。", "success");
      void loadImageConfig();
    } catch (error) {
      setImageConfigMessage(
        error instanceof Error ? error.message : "重置失败，请稍后重试。",
        "error",
      );
    } finally {
      imageCooldownReset.disabled = false;
    }
  });

  const loadImageConfig = async () => {
    const response = await fetch("/api/admin/image", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    });
    const payload = (await response.json()) as {
      settings?: AdminImageConfig;
      providers?: AdminImageProvider[];
      usage?: UsageRow[];
      today?: UsageToday;
      error?: string;
    };
    if (!response.ok || !payload.settings) {
      throw new Error(payload.error || "生图设置读取失败。");
    }
    fillImageConfig(
      payload.settings,
      payload.providers ?? [],
      payload.today ?? null,
      payload.usage ?? [],
      payload.recentAttempts ?? [],
    );
  };

  imageTestForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const prompt = imageTestPrompt?.value.trim() ?? "";
    if (prompt.length < 6 || !imageTestSubmit) {
      if (imageTestStatus) imageTestStatus.textContent = "测试提示词过短。";
      return;
    }
    imageTestSubmit.disabled = true;
    if (imageTestStatus) imageTestStatus.textContent = "正在生成测试图片…";
    try {
      const response = await fetch("/api/admin/image/test", {
        method: "POST",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          prompt,
          quality: imageTestQuality?.value === "hd" ? "hd" : "standard",
          aspectRatio: "1:1",
          requestId: crypto.randomUUID(),
        }),
      });
      const payload = (await response.json()) as {
        job?: {
          providerName?: string;
          model?: string;
          r2Key?: string;
          width?: number;
          height?: number;
          pointsCost?: number;
          balance?: number;
        };
        error?: string;
      };
      if (!response.ok || !payload.job) {
        throw new Error(payload.error || "生图测试失败。");
      }
      if (imageTestStatus) {
        imageTestStatus.textContent = `成功：${payload.job.providerName} / ${payload.job.model} / ${payload.job.width}×${payload.job.height} / 扣 ${payload.job.pointsCost} 积分 / 余额 ${payload.job.balance} / ${payload.job.r2Key}`;
      }
    } catch (error) {
      if (imageTestStatus) {
        imageTestStatus.textContent =
          error instanceof Error ? error.message : "生图测试失败。";
      }
    } finally {
      imageTestSubmit.disabled = false;
    }
  });

  imageConfigForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!imageConfigSubmit) return;
    imageConfigSubmit.disabled = true;
    setImageConfigMessage("正在保存生图控制…");
    const providers = Array.from(
      imageProviderList?.querySelectorAll<HTMLElement>(
        "[data-image-provider-id]",
      ) ?? [],
    ).map((card) => ({
      id: card.dataset.imageProviderId,
      enabled:
        card.querySelector<HTMLInputElement>(
          "[data-image-provider-enabled]",
        )?.checked ?? false,
      model:
        card.querySelector<HTMLInputElement>("[data-image-provider-model]")
          ?.value.trim() ?? "",
      priority: Number(
        card.querySelector<HTMLInputElement>(
          "[data-image-provider-priority]",
        )?.value ?? 100,
      ),
      apiKey:
        card.querySelector<HTMLInputElement>("[data-image-provider-key]")
          ?.value.trim() ?? "",
      baseUrl:
        card.querySelector<HTMLInputElement>("[data-image-provider-baseurl]")
          ?.value.trim() ?? "",
    }));
    try {
      const response = await fetch("/api/admin/image", {
        method: "PATCH",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          settings: {
            enabled: imageEnabledInput?.checked ?? false,
            standardPoints: Number(imageStandardInput?.value),
            hdPoints: Number(imageHdInput?.value),
            studioPoints: Number(imageStudioInput?.value),
            queueJumpPoints: Number(imageJumpInput?.value),
            dailyJobLimit: Number(imageDailyInput?.value),
            monthlyBudgetCents: Math.round(
              Number(imageBudgetInput?.value ?? 0) * 100,
            ),
          },
          providers,
        }),
      });
      const payload = (await response.json()) as {
        settings?: AdminImageConfig;
        providers?: AdminImageProvider[];
        usage?: UsageRow[];
        today?: UsageToday;
        error?: string;
      };
      if (!response.ok || !payload.settings) {
        throw new Error(payload.error || "生图控制保存失败。");
      }
      fillImageConfig(
        payload.settings,
        payload.providers ?? [],
        payload.today ?? null,
        payload.usage ?? [],
        payload.recentAttempts ?? [],
      );
      setImageConfigMessage("生图控制已保存。", "success");
    } catch (error) {
      setImageConfigMessage(
        error instanceof Error ? error.message : "生图控制保存失败。",
        "error",
      );
    } finally {
      imageConfigSubmit.disabled = false;
    }
  });

  void authClient
    .getSession()
    .then(async ({ data }) => {
      if (!data?.user) {
        if (gateTitle) gateTitle.textContent = "请先登录";
        if (gateCopy) gateCopy.textContent = "登录站长账号后才能管理生图。";
        gate?.removeAttribute("hidden");
        return;
      }
      try {
        await loadImageConfig();
        gate?.setAttribute("hidden", "");
        content?.removeAttribute("hidden");
        // 实时监控：每 15 秒自动刷新用量与最近调用；正在编辑输入框时跳过
        window.setInterval(() => {
          const active = document.activeElement;
          const editing =
            active instanceof HTMLInputElement ||
            active instanceof HTMLTextAreaElement ||
            active instanceof HTMLSelectElement;
          if (editing) return;
          void loadImageConfig().catch(() => undefined);
          const updated = document.querySelector("[data-usage-updated]");
          if (updated) {
            updated.textContent = `数据更新于 ${new Date().toLocaleTimeString("zh-CN")}`;
          }
        }, 15_000);
      } catch (error) {
        const requestError = error as Error & { status?: number };
        if (requestError.status === 403) {
          if (gateTitle) gateTitle.textContent = "没有管理权限";
          if (gateCopy) gateCopy.textContent = "当前账号不是站长。";
        } else if (requestError.status === 401) {
          if (gateTitle) gateTitle.textContent = "登录已过期";
          if (gateCopy) gateCopy.textContent = "请重新登录后再试。";
        } else {
          if (gateTitle) gateTitle.textContent = "暂时无法读取生图设置";
          if (gateCopy) {
            gateCopy.textContent =
              error instanceof Error ? error.message : "请稍后重试。";
          }
          if (gateLink) gateLink.hidden = true;
        }
        gate?.removeAttribute("hidden");
        if (status) status.textContent = "";
      }
    })
    .catch(() => {
      if (gateTitle) gateTitle.textContent = "无法验证登录状态";
      if (gateCopy) gateCopy.textContent = "请刷新页面后重试。";
      gate?.removeAttribute("hidden");
    });
</script>

