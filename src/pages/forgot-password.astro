---
import AuthLayout from "../components/AuthLayout.astro";
---

<AuthLayout
  title="找回密码"
  description="使用绑定邮箱验证码重置渔情登录密码。"
  eyebrow="PASSWORD RECOVERY"
  bodyClass="page-auth page-forgot-password"
>
  <p class="auth-description">
    输入账号绑定的邮箱，我们会发送一次性验证码。验证成功后即可设置新密码。
  </p>

  <form class="auth-email-form" data-recovery-email-form>
    <label>
      <span>账号邮箱</span>
      <input
        type="email"
        name="email"
        maxlength="254"
        autocomplete="email"
        placeholder="name@example.com"
        required
        data-recovery-email
      />
    </label>
    <button type="button" data-recovery-send>发送重置验证码</button>
  </form>

  <form class="auth-code-form auth-recovery-form" data-recovery-form hidden>
    <label>
      <span>6 位验证码</span>
      <input
        type="text"
        name="otp"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        placeholder="000000"
        data-recovery-code
      />
    </label>
    <label>
      <span>新密码</span>
      <input
        type="password"
        name="password"
        minlength="10"
        maxlength="128"
        autocomplete="new-password"
        placeholder="至少 10 个字符"
        data-recovery-password
      />
    </label>
    <label>
      <span>确认新密码</span>
      <input
        type="password"
        name="confirmPassword"
        minlength="10"
        maxlength="128"
        autocomplete="new-password"
        placeholder="再次输入新密码"
        data-recovery-confirm
      />
    </label>
    <button type="submit" data-recovery-submit>重置密码</button>
    <button class="auth-resend-code" type="button" data-recovery-resend disabled>
      重新发送
    </button>
  </form>

  <p class="auth-status" data-recovery-status aria-live="polite">
    验证码 10 分钟内有效。为保护账号隐私，无论邮箱是否存在都会显示相同的发送结果。
  </p>

  <a class="auth-back" href="/login/">← 返回登录</a>
</AuthLayout>

<script>
  const emailInput = document.querySelector<HTMLInputElement>(
    "[data-recovery-email]",
  );
  const recoveryForm = document.querySelector<HTMLFormElement>(
    "[data-recovery-form]",
  );
  const sendButton = document.querySelector<HTMLButtonElement>(
    "[data-recovery-send]",
  );
  const resendButton = document.querySelector<HTMLButtonElement>(
    "[data-recovery-resend]",
  );
  const codeInput = document.querySelector<HTMLInputElement>(
    "[data-recovery-code]",
  );
  const passwordInput = document.querySelector<HTMLInputElement>(
    "[data-recovery-password]",
  );
  const confirmInput = document.querySelector<HTMLInputElement>(
    "[data-recovery-confirm]",
  );
  const submitButton = document.querySelector<HTMLButtonElement>(
    "[data-recovery-submit]",
  );
  const status = document.querySelector<HTMLElement>("[data-recovery-status]");

  const setStatus = (
    message: string,
    state: "idle" | "error" | "success" = "idle",
  ) => {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  };

  const errorMessage = (
    payload: { error?: string; message?: string },
    fallback: string,
  ) => {
    const message = payload.message || payload.error || fallback;
    const normalized = message.toLowerCase();
    if (normalized.includes("invalid otp")) {
      return "验证码不正确或已过期。";
    }
    if (normalized.includes("too many attempts")) {
      return "验证码尝试次数过多，请重新发送。";
    }
    if (normalized.includes("rate limit")) {
      return "操作太频繁，请稍后再试。";
    }
    if (normalized.includes("password too short")) {
      return "密码至少需要 10 个字符。";
    }
    return message;
  };

  const initialEmail = new URLSearchParams(window.location.search)
    .get("email")
    ?.trim()
    .toLowerCase();
  if (initialEmail && emailInput) emailInput.value = initialEmail;

  let countdownTimer = 0;
  const startCooldown = (seconds: number) => {
    window.clearInterval(countdownTimer);
    let remaining = seconds;
    if (resendButton) {
      resendButton.disabled = true;
      resendButton.textContent = `重新发送（${remaining}s）`;
    }
    countdownTimer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(countdownTimer);
        if (resendButton) {
          resendButton.disabled = false;
          resendButton.textContent = "重新发送";
        }
        return;
      }
      if (resendButton) {
        resendButton.textContent = `重新发送（${remaining}s）`;
      }
    }, 1000);
  };

  const requestReset = async () => {
    const email = emailInput?.value.trim().toLowerCase() ?? "";
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setStatus("请输入有效的邮箱地址。", "error");
      return;
    }
    if (sendButton) sendButton.disabled = true;
    if (resendButton) resendButton.disabled = true;
    setStatus("正在发送重置验证码…");
    try {
      const response = await fetch(
        "/api/auth/email-otp/request-password-reset",
        {
          method: "POST",
          credentials: "same-origin",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email }),
        },
      );
      const payload = (await response.json()) as {
        error?: string;
        message?: string;
      };
      if (!response.ok) {
        throw new Error(errorMessage(payload, "验证码发送失败。"));
      }
      if (recoveryForm) recoveryForm.hidden = false;
      if (codeInput) {
        codeInput.value = "";
        codeInput.focus();
      }
      setStatus("如果邮箱存在，重置验证码已经发送，请检查邮箱。", "success");
      startCooldown(60);
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : "验证码发送失败。",
        "error",
      );
      if (resendButton) resendButton.disabled = false;
    } finally {
      if (sendButton) sendButton.disabled = false;
    }
  };

  sendButton?.addEventListener("click", () => void requestReset());
  resendButton?.addEventListener("click", () => void requestReset());

  codeInput?.addEventListener("input", () => {
    codeInput.value = codeInput.value.replace(/\D/g, "").slice(0, 6);
  });

  recoveryForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = emailInput?.value.trim().toLowerCase() ?? "";
    const otp = codeInput?.value.trim() ?? "";
    const password = passwordInput?.value ?? "";
    const confirmPassword = confirmInput?.value ?? "";

    if (!/^\d{6}$/.test(otp)) {
      setStatus("请输入 6 位数字验证码。", "error");
      return;
    }
    if (password.length < 10) {
      setStatus("新密码至少需要 10 个字符。", "error");
      return;
    }
    if (password !== confirmPassword) {
      setStatus("两次输入的密码不一致。", "error");
      return;
    }

    if (submitButton) submitButton.disabled = true;
    setStatus("正在重置密码…");
    try {
      const response = await fetch("/api/auth/email-otp/reset-password", {
        method: "POST",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ email, otp, password }),
      });
      const payload = (await response.json()) as {
        error?: string;
        message?: string;
      };
      if (!response.ok) {
        throw new Error(errorMessage(payload, "密码重置失败。"));
      }
      localStorage.setItem("yq-login-method", "password");
      setStatus("密码已重置，正在返回登录页…", "success");
      const target = new URL("/login/", window.location.origin);
      target.searchParams.set("email", email);
      target.searchParams.set("reset", "1");
      window.setTimeout(() => window.location.replace(target.href), 800);
    } catch (error) {
      if (submitButton) submitButton.disabled = false;
      setStatus(
        error instanceof Error ? error.message : "密码重置失败。",
        "error",
      );
    }
  });
</script>
