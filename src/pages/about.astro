---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title="关于"
  description={`关于${SITE.name}和作者${SITE.author.name}。`}
  schemaType="AboutPage"
>
  <section class="container about-page">
    <div class="page-topline">
      <p class="eyebrow">ABOUT / PROFILE</p>
      <span>EST. 2026</span>
    </div>

    <div class="about-hero">
      <h1>关于<br /><em>{SITE.name}</em></h1>
      <p>{SITE.tagline}。</p>
    </div>

    <div class="about-grid">
      <aside class="about-facts">
        <dl>
          <div>
            <dt>NAME</dt>
            <dd>{SITE.author.name}</dd>
          </div>
          <div>
            <dt>FOCUS</dt>
            <dd>AI / Making</dd>
          </div>
          <div>
            <dt>STATUS</dt>
            <dd><i aria-hidden="true"></i> Building</dd>
          </div>
          <div>
            <dt>CONTACT</dt>
            <dd><a href="/rss.xml">RSS ↗</a></dd>
          </div>
        </dl>
      </aside>

      <div class="about-content prose">
        <p class="lead">{SITE.about}</p>

        <h2>渔情是什么</h2>
        <p>
          渔情是一个正在长出来的小空间，也是一颗想做 AI 工作室的种子。
          这里会慢慢放上小耗子折腾过的小玩意、过程和想法。
        </p>

        <h2>关于作者</h2>
        <p>
          <strong>{SITE.author.name}</strong>。作者简介：{SITE.author.bio}
        </p>

        <h2>保持联系</h2>
        <p>
          你可以通过 <a href="/rss.xml">RSS</a> 订阅更新。
          也可以在任意文章下方留下评论——在配置 Giscus 之后。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
