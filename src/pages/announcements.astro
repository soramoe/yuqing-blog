---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="公告"
  description="查看渔情当前公告与历史公告。"
  bodyClass="page-announcements"
  schemaType="CollectionPage"
>
  <div class="container announcements-shell">
    <header class="announcements-head">
      <div>
        <p class="eyebrow">SITE NOTICES</p>
        <h1>公告</h1>
        <p>活动、维护与重要提醒。</p>
      </div>
      <div class="announcements-summary" aria-label="公告数量">
        <div>
          <strong data-current-count>—</strong>
          <span>当前</span>
        </div>
        <div>
          <strong data-history-count>—</strong>
          <span>历史</span>
        </div>
      </div>
    </header>

    <div class="announcements-toolbar">
      <div class="announcements-filters" role="tablist" aria-label="公告分类">
        <button
          class="is-active"
          type="button"
          role="tab"
          aria-selected="true"
          data-announcement-filter="current"
        >
          当前公告
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-announcement-filter="history"
        >
          历史公告
        </button>
      </div>
      <a href="/">返回首页</a>
    </div>

    <p class="announcements-loading" data-announcements-loading>
      正在读取公告…
    </p>
    <ol
      class="announcements-list"
      data-announcements-list
      aria-live="polite"
      hidden
    ></ol>
    <p class="auth-status" data-announcements-status aria-live="polite"></p>
  </div>
</BaseLayout>

<script>
  import type {
    AnnouncementArchiveItem,
    AnnouncementPlacement,
    AnnouncementType,
  } from "../lib/announcements";

  type AnnouncementFilter = "current" | "history";

  const loading = document.querySelector<HTMLElement>(
    "[data-announcements-loading]",
  );
  const list = document.querySelector<HTMLOListElement>(
    "[data-announcements-list]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-announcements-status]",
  );
  const currentCount = document.querySelector<HTMLElement>(
    "[data-current-count]",
  );
  const historyCount = document.querySelector<HTMLElement>(
    "[data-history-count]",
  );
  const filters = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      "[data-announcement-filter]",
    ),
  );
  const typeLabels: Record<AnnouncementType, string> = {
    info: "公告",
    success: "活动",
    warning: "提醒",
    maintenance: "维护",
  };
  const placementLabels: Record<AnnouncementPlacement, string> = {
    site: "全站",
    points: "积分页",
    shop: "兑换页",
    custom: "指定页面",
  };
  let announcements: AnnouncementArchiveItem[] = [];
  let activeFilter: AnnouncementFilter = "current";

  const formatDate = (timestamp: number) =>
    new Intl.DateTimeFormat("zh-CN", {
      month: "short",
      day: "numeric",
    }).format(new Date(timestamp));

  const renderAnnouncement = (
    announcement: AnnouncementArchiveItem,
    index: number,
  ) => {
    const item = document.createElement("li");
    item.className = "announcement-item";
    item.dataset.type = announcement.type;

    const indexLabel = document.createElement("span");
    indexLabel.className = "announcement-index";
    indexLabel.textContent = String(index + 1).padStart(2, "0");

    const content = document.createElement("article");
    const header = document.createElement("header");
    const heading = document.createElement("div");
    const type = document.createElement("span");
    type.className = "announcement-type";
    type.textContent = typeLabels[announcement.type];
    const title = document.createElement("h2");
    title.textContent = announcement.title;
    heading.append(type, title);

    const time = document.createElement("time");
    time.dateTime = new Date(announcement.createdAt).toISOString();
    time.textContent = formatDate(announcement.createdAt);
    header.append(heading, time);

    const body = document.createElement("p");
    body.textContent = announcement.body;

    const footer = document.createElement("footer");
    if (
      announcement.targetPath ||
      announcement.placement === "points" ||
      announcement.placement === "shop"
    ) {
      const location = document.createElement("span");
      location.textContent = announcement.targetPath
        ? `显示于 ${announcement.targetPath}`
        : placementLabels[announcement.placement];
      footer.append(location);
    }
    if (
      announcement.linkUrl &&
      /^(https:\/\/|\/)/i.test(announcement.linkUrl)
    ) {
      const link = document.createElement("a");
      link.href = announcement.linkUrl;
      link.textContent = announcement.linkText || "查看详情 →";
      footer.append(link);
    }

    content.append(header, body);
    if (footer.childElementCount > 0) content.append(footer);
    item.append(indexLabel, content);
    return item;
  };

  const renderFilter = (filter: AnnouncementFilter) => {
    activeFilter = filter;
    filters.forEach((button) => {
      const active = button.dataset.announcementFilter === filter;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-selected", String(active));
    });
    if (!list) return;
    const rows = announcements.filter((announcement) =>
      filter === "current" ? !announcement.expired : announcement.expired,
    );
    list.replaceChildren();

    if (rows.length === 0) {
      const empty = document.createElement("li");
      empty.className = "announcements-empty";
      empty.textContent =
        filter === "current" ? "当前没有公告。" : "还没有历史公告。";
      list.append(empty);
    } else {
      rows.forEach((announcement, index) =>
        list.append(renderAnnouncement(announcement, index)),
      );
    }
  };

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      renderFilter(
        button.dataset.announcementFilter === "history"
          ? "history"
          : "current",
      );
    });
  });

  fetch("/api/announcements?archive=1", {
    credentials: "same-origin",
    headers: { Accept: "application/json" },
  })
    .then(async (response) => {
      const payload = (await response.json()) as {
        announcements?: AnnouncementArchiveItem[];
        error?: string;
      };
      if (!response.ok) throw new Error(payload.error || "公告读取失败。");
      announcements = payload.announcements ?? [];
      const current = announcements.filter((item) => !item.expired);
      const history = announcements.filter((item) => item.expired);
      if (currentCount) currentCount.textContent = String(current.length);
      if (historyCount) historyCount.textContent = String(history.length);
      renderFilter(activeFilter);
      loading?.setAttribute("hidden", "");
      if (list) list.hidden = false;
    })
    .catch((error) => {
      loading?.setAttribute("hidden", "");
      if (status) {
        status.textContent =
          error instanceof Error ? error.message : "公告读取失败。";
        status.dataset.state = "error";
      }
    });
</script>

<style>
  .page-announcements main {
    padding-block: 58px 104px;
  }

  .announcements-shell {
    max-width: 900px;
  }

  .announcements-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--strong-border);
  }

  .announcements-head h1 {
    margin: 6px 0 5px;
    font-size: clamp(2.7rem, 7vw, 4.8rem);
    letter-spacing: -0.07em;
  }

  .announcements-head > div > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .announcements-summary {
    display: flex;
    border: 1px solid var(--border);
  }

  .announcements-summary > div {
    display: grid;
    min-width: 76px;
    padding: 10px 14px;
    text-align: center;
  }

  .announcements-summary > div + div {
    border-left: 1px solid var(--border);
  }

  .announcements-summary strong {
    color: var(--accent);
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .announcements-summary span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.58rem;
  }

  .announcements-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 18px;
  }

  .announcements-filters {
    display: flex;
    gap: 4px;
  }

  .announcements-filters button {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.68rem;
  }

  .announcements-filters button:hover,
  .announcements-filters button.is-active {
    border-color: var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .announcements-toolbar > a {
    border-bottom: 1px solid currentColor;
    color: var(--muted);
    font-size: 0.66rem;
  }

  .announcements-loading,
  .announcements-empty {
    margin: 28px 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .announcements-empty {
    padding: 24px;
    border: 1px dashed var(--border);
    list-style: none;
  }

  .announcements-list {
    display: grid;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .announcement-item {
    display: grid;
    align-items: start;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    grid-template-columns: 34px minmax(0, 1fr);
  }

  .announcement-item[data-type="success"] {
    border-left-color: #6eaf83;
  }

  .announcement-item[data-type="warning"],
  .announcement-item[data-type="maintenance"] {
    border-left-color: #c18a4d;
  }

  .announcement-index {
    padding-top: 2px;
    color: var(--strong-border);
    font-family: Consolas, monospace;
    font-size: 0.66rem;
  }

  .announcement-item article {
    display: grid;
    gap: 9px;
    min-width: 0;
  }

  .announcement-item article > header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
  }

  .announcement-item article > header > div {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .announcement-type {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .announcement-item h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
  }

  .announcement-item time {
    flex: 0 0 auto;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
  }

  .announcement-item article > p {
    margin: 0;
    color: color-mix(in srgb, var(--text) 80%, var(--muted));
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .announcement-item footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding-top: 2px;
    color: var(--muted);
    font-size: 0.61rem;
  }

  .announcement-item footer a {
    border-bottom: 1px solid currentColor;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .page-announcements main {
      padding-block: 36px 76px;
    }

    .announcements-head {
      align-items: center;
    }

    .announcements-head h1 {
      font-size: 2.8rem;
    }

    .announcements-summary > div {
      min-width: 58px;
      padding: 8px 10px;
    }

    .announcement-item {
      gap: 10px;
      padding: 15px 14px;
      grid-template-columns: 24px minmax(0, 1fr);
    }

    .announcement-item article > header {
      display: grid;
      gap: 4px;
    }

    .announcement-item article > header > div {
      display: grid;
      gap: 3px;
    }
  }
</style>
