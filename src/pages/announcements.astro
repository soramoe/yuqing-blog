---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="公告"
  description="查看渔情当前公告与历史公告。"
  bodyClass="page-announcements"
  schemaType="CollectionPage"
>
  <div class="container announcements-shell">
    <header class="announcements-head">
      <div>
        <p class="eyebrow">SITE NOTICES</p>
        <h1>公告</h1>
      </div>
      <p>活动、维护与站点状态都会集中记录在这里。</p>
    </header>

    <p class="announcements-loading" data-announcements-loading>
      正在读取公告…
    </p>
    <div class="announcements-groups" data-announcements-groups hidden></div>
    <p class="auth-status" data-announcements-status aria-live="polite"></p>
  </div>
</BaseLayout>

<script>
  import type {
    AnnouncementArchiveItem,
    AnnouncementPlacement,
    AnnouncementType,
  } from "../lib/announcements";

  const loading = document.querySelector<HTMLElement>(
    "[data-announcements-loading]",
  );
  const groups = document.querySelector<HTMLElement>(
    "[data-announcements-groups]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-announcements-status]",
  );
  const typeLabels: Record<AnnouncementType, string> = {
    info: "公告",
    success: "活动",
    warning: "提醒",
    maintenance: "维护",
  };
  const placementLabels: Record<AnnouncementPlacement, string> = {
    site: "全站",
    points: "积分页",
    shop: "兑换页",
    custom: "指定页面",
  };

  const setStatus = (message = "") => {
    if (!status) return;
    status.textContent = message;
  };

  const formatDate = (timestamp: number) =>
    new Intl.DateTimeFormat("zh-CN", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(timestamp));

  const renderAnnouncement = (
    announcement: AnnouncementArchiveItem,
  ) => {
    const article = document.createElement("article");
    article.className = "announcement-card";
    if (announcement.expired) article.classList.add("is-expired");

    const meta = document.createElement("div");
    meta.className = "announcement-card-meta";
    const type = document.createElement("span");
    type.textContent = typeLabels[announcement.type];
    const placement = document.createElement("span");
    placement.textContent = announcement.targetPath
      ? announcement.targetPath
      : placementLabels[announcement.placement];
    meta.append(type, placement);

    const title = document.createElement("h2");
    title.textContent = announcement.title;
    const body = document.createElement("p");
    body.textContent = announcement.body;
    const time = document.createElement("time");
    time.dateTime = new Date(announcement.createdAt).toISOString();
    time.textContent = `${formatDate(announcement.createdAt)}${
      announcement.endsAt
        ? ` · ${announcement.expired ? "已结束" : "截止"} ${formatDate(announcement.endsAt)}`
        : ""
    }`;
    const footer = document.createElement("footer");
    footer.append(time);

    if (
      announcement.linkUrl &&
      /^(https:\/\/|\/)/i.test(announcement.linkUrl)
    ) {
      const link = document.createElement("a");
      link.href = announcement.linkUrl;
      link.textContent = announcement.linkText || "查看详情";
      footer.append(link);
    }

    article.append(meta, title, body, footer);
    return article;
  };

  const renderGroup = (
    titleText: string,
    eyebrowText: string,
    announcements: AnnouncementArchiveItem[],
  ) => {
    const section = document.createElement("section");
    section.className = "announcements-group";
    const heading = document.createElement("div");
    heading.className = "announcements-group-head";
    const headingWrap = document.createElement("div");
    const eyebrow = document.createElement("p");
    eyebrow.className = "eyebrow";
    eyebrow.textContent = eyebrowText;
    const headingTitle = document.createElement("h2");
    headingTitle.textContent = titleText;
    headingWrap.append(eyebrow, headingTitle);
    const count = document.createElement("span");
    count.textContent = `${announcements.length} 条`;
    heading.append(headingWrap, count);
    section.append(heading);
    announcements.forEach((announcement) =>
      section.append(renderAnnouncement(announcement)),
    );
    return section;
  };

  fetch("/api/announcements?archive=1", {
    credentials: "same-origin",
    headers: { Accept: "application/json" },
  })
    .then(async (response) => {
      const payload = (await response.json()) as {
        announcements?: AnnouncementArchiveItem[];
        error?: string;
      };
      if (!response.ok) throw new Error(payload.error || "公告读取失败。");
      const announcements = payload.announcements ?? [];
      const current = announcements.filter((item) => !item.expired);
      const expired = announcements.filter((item) => item.expired);

      if (groups) {
        groups.replaceChildren();
        if (current.length > 0) {
          groups.append(renderGroup("当前公告", "CURRENT", current));
        }
        if (expired.length > 0) {
          groups.append(renderGroup("历史公告", "ARCHIVE", expired));
        }
        if (announcements.length === 0) {
          const empty = document.createElement("p");
          empty.className = "announcements-empty";
          empty.textContent = "当前还没有公告。";
          groups.append(empty);
        }
        groups.hidden = false;
      }
      loading?.setAttribute("hidden", "");
    })
    .catch((error) => {
      loading?.setAttribute("hidden", "");
      setStatus(error instanceof Error ? error.message : "公告读取失败。");
    });
</script>

<style>
  .page-announcements main {
    padding-block: 64px 110px;
  }

  .announcements-shell {
    max-width: 920px;
  }

  .announcements-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--strong-border);
  }

  .announcements-head h1 {
    margin: 7px 0 0;
    font-size: clamp(2.6rem, 7vw, 5rem);
    letter-spacing: -0.07em;
  }

  .announcements-head > p {
    max-width: 330px;
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .announcements-loading,
  .announcements-empty {
    margin: 30px 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .announcements-group {
    margin-top: 34px;
  }

  .announcements-group-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 12px;
  }

  .announcements-group-head h2 {
    margin: 4px 0 0;
    font-size: 1.2rem;
  }

  .announcements-group-head > span {
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.62rem;
  }

  .announcement-card {
    display: grid;
    gap: 9px;
    padding-block: 20px;
    border-top: 1px solid var(--border);
  }

  .announcement-card:last-child {
    border-bottom: 1px solid var(--border);
  }

  .announcement-card.is-expired {
    opacity: 0.6;
  }

  .announcement-card-meta,
  .announcement-card footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.59rem;
  }

  .announcement-card-meta span:first-child {
    color: var(--accent);
  }

  .announcement-card h2 {
    margin: 0;
    font-size: 1.08rem;
  }

  .announcement-card p {
    max-width: 720px;
    margin: 0;
    color: color-mix(in srgb, var(--text) 82%, var(--muted));
    font-size: 0.8rem;
    line-height: 1.8;
  }

  .announcement-card footer {
    justify-content: space-between;
    margin-top: 3px;
  }

  .announcement-card footer a {
    border-bottom: 1px solid currentColor;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .page-announcements main {
      padding-block: 38px 80px;
    }

    .announcements-head {
      display: grid;
      gap: 10px;
    }
  }
</style>
