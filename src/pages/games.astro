---
import SnakeGame from "../components/SnakeGame.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title="游戏"
  description={`${SITE.name}可以直接在浏览器里玩的 AI 小游戏。`}
  schemaType="CollectionPage"
  bodyClass="page-games"
>
  <div class="container games-shell">
    <header class="games-intro">
      <div class="page-topline">
        <p class="eyebrow">PLAYGROUND / AI GAMES</p>
        <span>01 GAME</span>
      </div>

      <div class="games-title-row">
        <h1>游戏</h1>
        <p>不用跳转，点开就玩。<br />先从一局贪吃蛇开始。</p>
      </div>
    </header>

    <section class="games-library" aria-labelledby="games-list-title">
      <div class="games-list-heading">
        <div>
          <p class="eyebrow">PLAYABLE / 01</p>
          <h2 id="games-list-title">现在可以玩</h2>
        </div>
        <span>点开卡片即可开始 · 无需跳转</span>
      </div>

      <SnakeGame />
    </section>
  </div>
</BaseLayout>

<style>
  .page-games main {
    padding-block: 52px 96px;
  }

  .games-shell {
    min-height: calc(100vh - 148px);
  }

  .games-intro {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--strong-border);
  }

  .games-title-row {
    display: grid;
    align-items: end;
    gap: 40px;
    padding-top: 44px;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.38fr);
  }

  .games-title-row h1 {
    margin: 0;
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .games-title-row > p {
    margin: 0;
    padding-top: 17px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .games-library {
    padding-top: 34px;
  }

  .games-list-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }

  .games-list-heading h2 {
    margin: 8px 0 0;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .games-list-heading > span {
    padding-bottom: 2px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 820px) {
    .page-games main {
      padding-block: 38px 72px;
    }

    .games-shell {
      min-height: 0;
    }

    .games-title-row {
      gap: 26px;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .page-games main {
      padding-block: 30px 60px;
    }

    .games-intro {
      padding-bottom: 26px;
    }

    .games-title-row {
      padding-top: 34px;
    }

    .games-title-row h1 {
      font-size: 4.2rem;
    }

    .games-library {
      padding-top: 26px;
    }

    .games-list-heading {
      display: grid;
      gap: 10px;
    }

    .games-list-heading > span {
      line-height: 1.5;
    }
  }
</style>
