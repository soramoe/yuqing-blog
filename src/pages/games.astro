---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
---

<BaseLayout
  title="游戏"
  description={`${SITE.name}的 AI 小游戏。`}
  bodyClass="page-games"
>
  <div class="container games-shell">
    <header class="games-intro">
      <div class="page-topline">
        <p class="eyebrow">PLAYGROUND / AI GAMES</p>
        <span>00 GAMES</span>
      </div>

      <div class="games-title-row">
        <h1>游戏</h1>
        <p>可以直接在浏览器里玩的小实验。<br />很快见面。</p>
      </div>
    </header>

    <section class="games-empty" aria-labelledby="games-empty-title">
      <span class="games-empty-number" aria-hidden="true">00</span>
      <div class="games-empty-copy">
        <p class="eyebrow">COMING SOON</p>
        <h2 id="games-empty-title">第一局正在准备</h2>
        <p>这里会陆续放上可以直接玩的 AI 小游戏，目前还是空的。</p>
      </div>
      <span class="games-empty-line" aria-hidden="true"></span>
    </section>
  </div>
</BaseLayout>

<style>
  .page-games main {
    padding-block: 52px 96px;
  }

  .games-shell {
    min-height: calc(100vh - 148px);
  }

  .games-intro {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--strong-border);
  }

  .games-title-row {
    display: grid;
    align-items: end;
    gap: 40px;
    padding-top: 44px;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.38fr);
  }

  .games-title-row h1 {
    margin: 0;
    font-size: clamp(4rem, 8vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .games-title-row > p {
    margin: 0;
    padding-top: 17px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .games-empty {
    position: relative;
    display: flex;
    min-height: 390px;
    align-items: flex-end;
    gap: clamp(28px, 6vw, 84px);
    overflow: hidden;
    margin-top: 32px;
    padding: clamp(28px, 5vw, 58px);
    border: 1px solid var(--border);
    background:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px),
      color-mix(in srgb, var(--surface) 72%, transparent);
    background-size: 42px 42px;
  }

  .games-empty::before {
    position: absolute;
    top: -72px;
    right: 11%;
    width: 230px;
    height: 230px;
    border: 1px solid var(--strong-border);
    border-radius: 50%;
    content: "";
    opacity: 0.6;
  }

  .games-empty-number {
    position: relative;
    z-index: 1;
    color: var(--accent);
    font-family: Consolas, monospace;
    font-size: clamp(5rem, 12vw, 10rem);
    line-height: 0.72;
  }

  .games-empty-copy {
    position: relative;
    z-index: 1;
    max-width: 500px;
  }

  .games-empty-copy h2 {
    margin: 10px 0;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .games-empty-copy > p:last-child {
    max-width: 430px;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .games-empty-line {
    position: absolute;
    top: 28px;
    right: 28px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  @media (max-width: 820px) {
    .page-games main {
      padding-block: 38px 72px;
    }

    .games-shell {
      min-height: 0;
    }

    .games-title-row {
      gap: 26px;
      grid-template-columns: 1fr;
    }

    .games-empty {
      min-height: 350px;
    }
  }

  @media (max-width: 520px) {
    .page-games main {
      padding-block: 30px 60px;
    }

    .games-intro {
      padding-bottom: 26px;
    }

    .games-title-row {
      padding-top: 34px;
    }

    .games-title-row h1 {
      font-size: 4.2rem;
    }

    .games-empty {
      min-height: 360px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: space-between;
      gap: 38px;
      padding: 28px 23px;
    }

    .games-empty-number {
      font-size: 5rem;
    }

    .games-empty-line {
      top: 22px;
      right: 22px;
    }
  }
</style>
