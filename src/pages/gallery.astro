---
import GalleryLightbox from "../components/GalleryLightbox.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/blog";
import { galleryImages as localGalleryImages } from "../lib/gallery";
import { getResponsiveImage } from "../lib/images";
import { SITE } from "../site.config";

const posts = await getPublishedPosts();
const galleryImages = localGalleryImages.map((image) => ({
  ...image,
  href: image.cover,
  isGallery: true,
}));

const coverImages = posts
  .filter((post) => Boolean(post.data.cover))
  .map((post) => ({
    title: post.data.title,
    cover: post.data.cover!,
    href: `/blog/${post.id}/`,
    sortKey: post.data.pubDate.toISOString(),
    isGallery: false,
    width: undefined,
    height: undefined,
  }));

const images = [...galleryImages, ...coverImages].sort((a, b) =>
  b.sortKey.localeCompare(a.sortKey),
);
---

<BaseLayout
  title="图库"
  description={`${SITE.name}的封面与视觉记录。`}
  schemaType="CollectionPage"
  bodyClass="page-gallery"
>
  <h1 class="sr-only">{SITE.name}图库</h1>

  <section class="container gallery-page" aria-label="图库">
    {
      images.length > 0 ? (
        <div class="waterfall-grid" data-gallery-grid>
          {images.map((image, index) => {
            const aspect =
              image.width && image.height
                ? `${image.width} / ${image.height}`
                : "16 / 10";
            const thumbnail = getResponsiveImage(image.cover, [480, 960]);
            const preview = getResponsiveImage(
              image.cover,
              [480, 960, 1920],
            );
            const previewSrc = preview.variants.at(-1) ?? image.href;

            return (
              <a
                class="waterfall-item"
                href={image.isGallery ? previewSrc : image.href}
                data-gallery-open={image.isGallery ? "true" : undefined}
                data-gallery-title={image.title}
                data-gallery-srcset={
                  image.isGallery ? preview.srcSet : undefined
                }
                data-gallery-sizes={
                  image.isGallery
                    ? "(max-width: 820px) 100vw, (max-width: 1915px) 94vw, 1800px"
                    : undefined
                }
                style={`--gallery-aspect: ${aspect}`}
              >
                <img
                  data-gallery-image
                  src={thumbnail.src}
                  srcset={thumbnail.srcSet}
                  sizes="(max-width: 820px) 50vw, (max-width: 1200px) 33vw, 25vw"
                  alt={image.title}
                  width={image.width}
                  height={image.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                />
                <span>{image.title}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="gallery-empty">还没有可以展示的图片。</p>
      )
    }
  </section>

  <GalleryLightbox />

  <script>
    const markImageLoaded = (image) => {
      image.closest(".waterfall-item")?.classList.add("is-loaded");
    };

    for (const image of document.querySelectorAll("[data-gallery-image]")) {
      if (image.complete) {
        markImageLoaded(image);
      } else {
        image.addEventListener("load", () => markImageLoaded(image), { once: true });
        image.addEventListener(
          "error",
          () => image.closest(".waterfall-item")?.classList.add("is-error"),
          { once: true },
        );
      }
    }
  </script>
</BaseLayout>
