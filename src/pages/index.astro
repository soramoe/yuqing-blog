---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readdirSync } from "node:fs";
import path from "node:path";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import { formatDate, getPublishedPosts, getReadingTime } from "../lib/blog";
import { getResponsiveImage } from "../lib/images";
import { SITE } from "../site.config";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 4);
const galleryDirectory = path.join(process.cwd(), "assets", "gallery");
const galleryExtensions = new Set([".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif"]);

const galleryImages = readdirSync(galleryDirectory, { withFileTypes: true })
  .filter(
    (entry) =>
      entry.isFile() &&
      galleryExtensions.has(path.extname(entry.name).toLowerCase()),
  )
  .map((entry) => {
    const fileName = entry.name;
    const dateMatch = fileName.match(/^(\d{4})(\d{2})(\d{2})_/);
    const date = dateMatch
      ? `${dateMatch[1]}.${dateMatch[2]}.${dateMatch[3]}`
      : null;
    const title = date ? `渔图 · ${date}` : "渔情图库";
    const thumbnail = getResponsiveImage(`/gallery/${fileName}`, [480, 960]);
    const lightbox = getResponsiveImage(
      `/gallery/${fileName}`,
      [480, 960, 1920],
    );

    return {
      href: lightbox.variants.at(-1) ?? lightbox.src,
      preview: thumbnail.src,
      srcSet: thumbnail.srcSet,
      lightboxSrcSet: lightbox.srcSet,
      title,
      alt: title,
      sortKey: dateMatch ? dateMatch[0] : "",
    };
  })
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));

const homeGalleryImages = galleryImages.slice(0, 4);
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).slice(
  0,
  8,
);
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  schemaType="WebSite"
  bodyClass="page-home"
>
  <h1 class="sr-only">{SITE.name} · {SITE.tagline}</h1>

  <section class="container home-columns" aria-label="首页内容">
    <div class="home-gallery">
      <div class="home-column-head">
        <div>
          <p class="eyebrow">VISUAL LOG</p>
          <h2>最近的光影</h2>
        </div>
        <a class="column-link" href="/gallery/">全部图库 <span aria-hidden="true">↗</span></a>
      </div>

      {
        homeGalleryImages.length > 0 ? (
          <div class="home-gallery-grid">
            {homeGalleryImages.map((image, index) => (
              <a
                class="home-gallery-item"
                href={image.href}
                aria-label={`${image.title}，打开图片预览`}
                data-gallery-open="true"
                data-gallery-title={image.title}
                data-gallery-srcset={image.lightboxSrcSet}
                data-gallery-sizes="(max-width: 1915px) 94vw, 1800px"
              >
                <img
                  src={image.preview}
                  srcset={image.srcSet}
                  sizes="(max-width: 600px) 44vw, 24vw"
                  alt={image.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                />
                <span class="home-gallery-caption">
                  <span>{image.title}</span>
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="home-empty">图库里还没有图片。</p>
        )
      }
    </div>

    <div class="home-posts">
      <div class="home-column-head">
        <div>
          <p class="eyebrow">LATEST WRITING</p>
          <h2>最近写的</h2>
        </div>
        <a class="column-link" href="/blog/">全部文章 <span aria-hidden="true">↗</span></a>
      </div>

      {
        latestPosts.length > 0 ? (
          <ol class="home-post-list">
            {latestPosts.map((post, index) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="home-post-link"
                  title={post.data.title}
                >
                  <span class="home-post-index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="home-post-copy">
                    <span class="home-post-meta">
                      <span class="home-post-category">{post.data.category}</span>
                      <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate)}
                      </time>
                      <span>{getReadingTime(post.body)} MIN</span>
                    </span>
                    <strong>{post.data.title}</strong>
                    <span class="home-post-description">{post.data.description}</span>
                  </span>
                  <span class="home-post-thumb" aria-hidden="true">
                    {post.data.cover ? (
                      <img
                        src={getResponsiveImage(post.data.cover, [480, 960]).src}
                        srcset={getResponsiveImage(post.data.cover, [480, 960]).srcSet}
                        sizes="88px"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span>{post.data.category.slice(0, 1)}</span>
                    )}
                  </span>
                  <span class="home-post-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="home-empty">还没有发布文章。</p>
        )
      }

      <div
        class="home-connection"
        data-connection-status
        aria-live="polite"
        title="浏览器网络与页面加载状态"
      >
        <div class="home-connection-state">
          <span class="home-connection-dot" aria-hidden="true"></span>
          <span data-connection-label>正在检测连接</span>
          <small>NETWORK</small>
        </div>
        <div class="home-connection-monitor">
          <svg
            class="home-connection-pulse"
            viewBox="0 0 120 28"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="home-connection-track"
              d="M0 14h24l5-8 5 16 5-22 6 20 5-6h18l4-5 4 10 4-5h40"
              pathLength="100"
            />
            <path
              class="home-connection-wave"
              d="M0 14h24l5-8 5 16 5-22 6 20 5-6h18l4-5 4 10 4-5h40"
              pathLength="100"
            />
            <path
              class="home-connection-flat"
              d="M0 14h120"
              pathLength="100"
            />
          </svg>
          <div class="home-connection-metrics">
            <span>加载 <b data-page-load>—</b></span>
            <span data-connection-detail>检测网络质量</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container home-explore" aria-labelledby="explore-title">
    <div class="home-explore-head">
      <div>
        <p class="eyebrow">KEEP EXPLORING</p>
        <h2 id="explore-title">继续逛逛</h2>
      </div>
      <p>从文章归档、完整图库或站点介绍继续。</p>
    </div>

    <nav class="home-explore-grid" aria-label="更多浏览入口">
      <a href="/blog/">
        <span>01 / ARCHIVE</span>
        <strong>全部文章</strong>
        <small>{String(posts.length).padStart(2, "0")} 篇记录 <b aria-hidden="true">↗</b></small>
      </a>
      <a href="/gallery/">
        <span>02 / VISUAL LOG</span>
        <strong>完整图库</strong>
        <small>{String(galleryImages.length).padStart(2, "0")} 张图片 <b aria-hidden="true">↗</b></small>
      </a>
      <a href="/about/">
        <span>03 / ABOUT</span>
        <strong>关于渔情</strong>
        <small>认识这里 <b aria-hidden="true">↗</b></small>
      </a>
    </nav>

    {
      tags.length > 0 && (
        <div class="home-tag-row" aria-label="文章标签">
          <span>标签</span>
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )
    }
  </section>

  <GalleryLightbox />

  <script>
    const connectionStatus = document.querySelector("[data-connection-status]");
    const connectionLabel = document.querySelector("[data-connection-label]");
    const connectionDetail = document.querySelector("[data-connection-detail]");
    const pageLoad = document.querySelector("[data-page-load]");

    type NetworkInformation = {
      effectiveType?: string;
      downlink?: number;
      rtt?: number;
      saveData?: boolean;
      addEventListener?: (type: "change", listener: () => void) => void;
    };

    const networkConnection = (
      navigator as Navigator & { connection?: NetworkInformation }
    ).connection;

    const updateConnectionStatus = () => {
      if (!connectionStatus || !connectionLabel) return;

      const isOnline = navigator.onLine;
      connectionStatus.classList.toggle("is-offline", !isOnline);
      connectionStatus.setAttribute("data-state", isOnline ? "online" : "offline");
      connectionLabel.textContent = isOnline ? "网络已连接" : "当前已离线";

      if (!connectionDetail) return;
      if (!isOnline) {
        connectionDetail.textContent = "OFFLINE";
        return;
      }

      const details: string[] = [];
      if (networkConnection?.effectiveType) {
        details.push(networkConnection.effectiveType.toUpperCase());
      }
      if (typeof networkConnection?.downlink === "number") {
        details.push(`${networkConnection.downlink.toFixed(1)} Mbps`);
      }
      if (typeof networkConnection?.rtt === "number") {
        details.push(`${networkConnection.rtt} ms RTT`);
      }
      connectionDetail.textContent =
        details.length > 0 ? details.join(" · ") : "网络质量未知";
    };

    const updatePageLoad = () => {
      if (!pageLoad) return;

      const navigationEntry = performance.getEntriesByType(
        "navigation",
      )[0] as PerformanceNavigationTiming | undefined;
      const loadTime =
        navigationEntry?.loadEventEnd ||
        navigationEntry?.duration ||
        performance.now();
      pageLoad.textContent =
        loadTime > 0 ? `${Math.round(loadTime)} ms` : "测量中";
    };

    updateConnectionStatus();
    if (document.readyState === "complete") {
      updatePageLoad();
    } else {
      window.addEventListener("load", updatePageLoad, { once: true });
    }
    window.addEventListener("online", updateConnectionStatus);
    window.addEventListener("offline", updateConnectionStatus);
    networkConnection?.addEventListener?.("change", updateConnectionStatus);
  </script>
</BaseLayout>

<style>
  .page-home main {
    padding-block: 42px 80px;
  }

  .home-columns {
    display: grid;
    align-items: start;
    gap: clamp(30px, 4vw, 56px);
    padding-top: 34px;
    grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.88fr);
  }

  .home-posts {
    display: flex;
    align-self: stretch;
    flex-direction: column;
  }

  .home-column-head {
    display: flex;
    min-height: 54px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .home-column-head h2 {
    margin: 5px 0 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .column-link {
    flex: 0 0 auto;
    padding-top: 2px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .column-link:hover {
    border-color: currentColor;
    color: var(--text);
  }

  .column-link span {
    margin-left: 5px;
    color: var(--accent);
  }

  .home-gallery-grid {
    display: grid;
    height: clamp(420px, 48vw, 570px);
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }

  .home-gallery-item {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .home-gallery-item::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.1);
    content: "";
    pointer-events: none;
  }

  .home-gallery-item::before {
    position: absolute;
    inset: 52% 0 0;
    z-index: 1;
    background: linear-gradient(transparent, rgba(5, 6, 8, 0.72));
    content: "";
    opacity: 0.8;
    pointer-events: none;
  }

  .home-gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 260ms ease,
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .home-gallery-item noscript {
    display: contents;
  }

  .home-gallery-item:hover img,
  .home-gallery-item:focus-visible img {
    transform: scale(1.025);
  }

  .home-gallery-caption {
    position: absolute;
    right: 12px;
    bottom: 10px;
    left: 12px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: rgba(255, 255, 255, 0.82);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  .home-gallery-caption span:last-child {
    color: #fff;
    font-size: 0.7rem;
  }

  .home-post-list {
    margin: 0 0 12px;
    padding: 0;
    border-top: 1px solid var(--strong-border);
    list-style: none;
  }

  .home-post-list li {
    border-bottom: 1px solid var(--border);
  }

  .home-post-link {
    display: grid;
    align-items: center;
    gap: 13px;
    padding-block: 17px;
    grid-template-columns: 22px minmax(0, 1fr) 88px 12px;
  }

  .home-post-index {
    padding-top: 2px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
  }

  .home-post-copy {
    display: grid;
    min-width: 0;
    gap: 5px;
  }

  .home-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.57rem;
    letter-spacing: 0.035em;
  }

  .home-post-category {
    color: var(--accent);
    font-weight: 700;
  }

  .home-post-copy strong {
    display: block;
    min-width: 0;
    overflow: hidden;
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.42;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-post-description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .home-post-thumb {
    display: grid;
    width: 88px;
    aspect-ratio: 4 / 3;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    font-size: 1.3rem;
    font-weight: 800;
  }

  .home-post-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .home-post-link:hover .home-post-thumb img {
    transform: scale(1.04);
  }

  .home-post-arrow {
    color: var(--muted);
    font-size: 0.72rem;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .home-post-link:hover strong,
  .home-post-link:hover .home-post-arrow {
    color: var(--accent);
  }

  .home-post-link:hover .home-post-arrow {
    transform: translate(2px, -2px);
  }

  .home-connection {
    display: grid;
    gap: 9px;
    margin-top: auto;
    padding: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 58%, transparent);
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.035em;
  }

  .home-connection-state {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .home-connection-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #62d28a;
    box-shadow: 0 0 0 4px rgba(98, 210, 138, 0.1);
  }

  .home-connection-state small {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.52rem;
  }

  .home-connection-monitor {
    display: grid;
    align-items: center;
    gap: 12px;
    grid-template-columns: minmax(88px, 1fr) minmax(120px, auto);
  }

  .home-connection-pulse {
    display: block;
    width: 100%;
    height: 28px;
    overflow: visible;
  }

  .home-connection-track,
  .home-connection-wave,
  .home-connection-flat {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .home-connection-track {
    stroke: var(--border);
    stroke-width: 1;
  }

  .home-connection-wave {
    stroke: #62d28a;
    stroke-dasharray: 18 82;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
    filter: drop-shadow(0 0 3px rgba(98, 210, 138, 0.45));
    animation: home-connection-trace 2.4s linear infinite;
  }

  .home-connection-flat {
    opacity: 0;
    stroke: #e38276;
    stroke-width: 1.2;
  }

  .home-connection-metrics {
    display: grid;
    justify-items: end;
    gap: 2px;
    line-height: 1.45;
    text-align: right;
  }

  .home-connection-metrics b {
    color: var(--text);
    font-weight: 500;
  }

  .home-connection.is-offline .home-connection-wave {
    opacity: 0;
    animation: none;
  }

  .home-connection.is-offline .home-connection-flat {
    opacity: 1;
  }

  .home-connection.is-offline .home-connection-dot {
    background: #e38276;
    box-shadow: 0 0 0 4px rgba(227, 130, 118, 0.1);
  }

  @keyframes home-connection-trace {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -100;
    }
  }

  .home-empty {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .home-explore {
    margin-top: 60px;
    padding-top: 28px;
    border-top: 1px solid var(--strong-border);
  }

  .home-explore-head {
    display: grid;
    align-items: end;
    gap: 24px;
    margin-bottom: 20px;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
  }

  .home-explore h2 {
    margin: 5px 0 0;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
  }

  .home-explore-head > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .home-explore-grid {
    display: grid;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-explore-grid > a {
    display: grid;
    min-height: 132px;
    align-content: space-between;
    gap: 20px;
    padding: 16px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 65%, transparent);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .home-explore-grid > a:hover {
    background: var(--surface);
    color: var(--accent);
  }

  .home-explore-grid span,
  .home-explore-grid small {
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
  }

  .home-explore-grid strong {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .home-explore-grid small {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .home-explore-grid b {
    color: var(--accent);
    font-weight: 400;
  }

  .home-tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 18px;
  }

  .home-tag-row > span {
    margin-right: 4px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .home-tag-row a {
    padding: 4px 8px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.66rem;
  }

  .home-tag-row a:hover {
    border-color: var(--strong-border);
    color: var(--text);
  }

  @media (max-width: 980px) {
    .home-columns {
      grid-template-columns: 1fr;
    }

    .home-gallery {
      padding-bottom: 22px;
      border-bottom: 1px solid var(--strong-border);
    }

    .home-gallery-grid {
      height: auto;
      aspect-ratio: 1.15;
    }

    .home-explore {
      margin-top: 42px;
    }
  }

  @media (max-width: 600px) {
    .page-home main {
      padding-top: 34px;
    }

    .home-columns {
      gap: 28px;
      padding-top: 28px;
    }

    .home-gallery-grid {
      height: auto;
      aspect-ratio: 1 / 1.12;
    }

    .home-column-head {
      min-height: 48px;
    }

    .column-link {
      font-size: 0.66rem;
    }

    .home-post-link {
      gap: 10px;
      grid-template-columns: 20px minmax(0, 1fr) 72px 12px;
    }

    .home-post-thumb {
      width: 72px;
    }

    .home-explore-head {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .home-explore-grid {
      grid-template-columns: 1fr;
    }

    .home-explore-grid > a {
      min-height: 100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-connection-wave {
      animation: none;
    }
  }
</style>
