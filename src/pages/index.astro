---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowUpRight from "../components/ArrowUpRight.astro";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import {
  formatDate,
  getPostPublishedAt,
  getPublishedPosts,
  getReadingTime,
} from "../lib/blog";
import { galleryImages } from "../lib/gallery";
import { getResponsiveImage } from "../lib/images";
import { SITE } from "../site.config";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 4);
const homeGalleryImages = galleryImages.slice(0, 4).map((image) => {
  const thumbnail = getResponsiveImage(image.cover, [480, 960]);
  const lightbox = getResponsiveImage(image.cover, [480, 960, 1920]);

  return {
    href: lightbox.variants.at(-1) ?? lightbox.src,
    preview: thumbnail.src,
    srcSet: thumbnail.srcSet,
    lightboxSrcSet: lightbox.srcSet,
    title: image.title,
    alt: image.title,
  };
});
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).slice(
  0,
  8,
);
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  schemaType="WebSite"
  bodyClass="page-home"
>
  <h1 class="sr-only">{SITE.name} · {SITE.tagline}</h1>

  <section class="container home-columns" aria-label="首页内容">
    <div class="home-gallery">
      <div class="home-column-head">
        <div>
          <p class="eyebrow">VISUAL LOG</p>
          <h2>最近的光影</h2>
        </div>
        <a class="column-link" href="/gallery/">全部图库 <span aria-hidden="true"><ArrowUpRight /></span></a>
      </div>

      <div
        class="home-gallery-grid"
        data-home-gallery-grid
        hidden={homeGalleryImages.length === 0}
      >
        {homeGalleryImages.map((image, index) => (
          <a
            class="home-gallery-item"
            href={image.href}
            aria-label={`${image.title}，打开图片预览`}
            data-gallery-open="true"
            data-gallery-title={image.title}
            data-gallery-srcset={image.lightboxSrcSet}
            data-gallery-sizes="(max-width: 1915px) 94vw, 1800px"
          >
            <img
              src={image.preview}
              srcset={image.srcSet}
              sizes="(max-width: 600px) 44vw, 24vw"
              alt={image.alt}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
            />
          </a>
        ))}
      </div>
      <p
        class="home-empty"
        data-home-gallery-empty
        hidden={homeGalleryImages.length > 0}
      >
        图库里还没有图片。
      </p>
    </div>

    <div class="home-posts">
      <div class="home-column-head">
        <div>
          <p class="eyebrow">LATEST WRITING</p>
          <h2>最近写的</h2>
        </div>
        <a class="column-link" href="/blog/">全部文章 <span aria-hidden="true"><ArrowUpRight /></span></a>
      </div>

      {
        latestPosts.length > 0 ? (
          <ol class="home-post-list">
            {latestPosts.map((post, index) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="home-post-link"
                  title={post.data.title}
                >
                  <span class="home-post-index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="home-post-copy">
                    <span class="home-post-meta">
                      <span class="home-post-category">{post.data.category}</span>
                      <time datetime={getPostPublishedAt(post).toISOString()}>
                        {formatDate(getPostPublishedAt(post))}
                      </time>
                      <span>{getReadingTime(post.body)} MIN</span>
                    </span>
                    <strong>{post.data.title}</strong>
                    <span class="home-post-description">{post.data.description}</span>
                  </span>
                  <span class="home-post-thumb" aria-hidden="true">
                    {post.data.cover && !post.data.hideCover ? (
                      <img
                        src={getResponsiveImage(post.data.cover, [480, 960]).src}
                        srcset={getResponsiveImage(post.data.cover, [480, 960]).srcSet}
                        sizes="88px"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span>{post.data.category.slice(0, 1)}</span>
                    )}
                  </span>
                  <span class="home-post-arrow" aria-hidden="true"><ArrowUpRight /></span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="home-empty">还没有发布文章。</p>
        )
      }

      <div
        class="home-connection"
        data-connection-status
        aria-live="polite"
        title="浏览器网络与页面加载状态"
      >
        <div class="home-connection-state">
          <span class="home-connection-dot" aria-hidden="true"></span>
          <span data-connection-label>正在检测连接</span>
          <small>NETWORK</small>
        </div>
        <div class="home-connection-monitor">
          <svg
            class="home-connection-pulse"
            viewBox="0 0 120 28"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="home-connection-track"
              d="M0 14h24l5-8 5 16 5-22 6 20 5-6h18l4-5 4 10 4-5h40"
              pathLength="100"
            />
            <path
              class="home-connection-wave"
              d="M0 14h24l5-8 5 16 5-22 6 20 5-6h18l4-5 4 10 4-5h40"
              pathLength="100"
            />
            <path
              class="home-connection-flat"
              d="M0 14h120"
              pathLength="100"
            />
          </svg>
          <div class="home-connection-metrics">
            <span>加载 <b data-page-load>—</b></span>
            <span data-connection-detail>检测网络质量</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container home-explore" aria-labelledby="explore-title">
    <div class="home-explore-head">
      <div>
        <p class="eyebrow">KEEP EXPLORING</p>
        <h2 id="explore-title">继续逛逛</h2>
      </div>
      <p>从文章归档、完整图库或站点介绍继续。</p>
    </div>

    <nav class="home-explore-grid" aria-label="更多浏览入口">
      <a href="/blog/">
        <span>01 / ARCHIVE</span>
        <strong>全部文章</strong>
        <small>{String(posts.length).padStart(2, "0")} 篇记录 <b aria-hidden="true"><ArrowUpRight /></b></small>
      </a>
      <a href="/gallery/">
        <span>02 / VISUAL LOG</span>
        <strong>完整图库</strong>
        <small>
          <span data-home-gallery-count>{String(galleryImages.length).padStart(2, "0")}</span>
          张图片 <b aria-hidden="true"><ArrowUpRight /></b>
        </small>
      </a>
      <a href="/about/">
        <span>03 / ABOUT</span>
        <strong>关于渔情</strong>
        <small>认识这里 <b aria-hidden="true"><ArrowUpRight /></b></small>
      </a>
    </nav>

    {
      tags.length > 0 && (
        <div class="home-tag-row" aria-label="文章标签">
          <span>标签</span>
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )
    }
  </section>

  <GalleryLightbox />

  <script>
    const connectionStatus = document.querySelector("[data-connection-status]");
    const connectionLabel = document.querySelector("[data-connection-label]");
    const connectionDetail = document.querySelector("[data-connection-detail]");
    const pageLoad = document.querySelector("[data-page-load]");

    type NetworkInformation = {
      effectiveType?: string;
      downlink?: number;
      rtt?: number;
      saveData?: boolean;
      addEventListener?: (type: "change", listener: () => void) => void;
    };

    const networkConnection = (
      navigator as Navigator & { connection?: NetworkInformation }
    ).connection;

    const updateConnectionStatus = () => {
      if (!connectionStatus || !connectionLabel) return;

      const isOnline = navigator.onLine;
      connectionStatus.classList.toggle("is-offline", !isOnline);
      connectionStatus.setAttribute("data-state", isOnline ? "online" : "offline");
      connectionLabel.textContent = isOnline ? "网络已连接" : "当前已离线";

      if (!connectionDetail) return;
      if (!isOnline) {
        connectionDetail.textContent = "OFFLINE";
        return;
      }

      const details: string[] = [];
      if (networkConnection?.effectiveType) {
        details.push(networkConnection.effectiveType.toUpperCase());
      }
      if (typeof networkConnection?.downlink === "number") {
        details.push(`${networkConnection.downlink.toFixed(1)} Mbps`);
      }
      if (typeof networkConnection?.rtt === "number") {
        details.push(`${networkConnection.rtt} ms RTT`);
      }
      connectionDetail.textContent =
        details.length > 0 ? details.join(" · ") : "网络质量未知";
    };

    const updatePageLoad = () => {
      if (!pageLoad) return;

      const navigationEntry = performance.getEntriesByType(
        "navigation",
      )[0] as PerformanceNavigationTiming | undefined;
      const loadTime =
        navigationEntry?.loadEventEnd ||
        navigationEntry?.duration ||
        performance.now();
      pageLoad.textContent =
        loadTime > 0 ? `${Math.round(loadTime)} ms` : "测量中";
    };

    updateConnectionStatus();
    if (document.readyState === "complete") {
      updatePageLoad();
    } else {
      window.addEventListener("load", updatePageLoad, { once: true });
    }
    window.addEventListener("online", updateConnectionStatus);
    window.addEventListener("offline", updateConnectionStatus);
    networkConnection?.addEventListener?.("change", updateConnectionStatus);
  </script>

  <script>
    import type { OnlineGalleryItem } from "../lib/gallery-upload";

    const homeGalleryGrid = document.querySelector<HTMLElement>(
      "[data-home-gallery-grid]",
    );
    const homeGalleryEmpty = document.querySelector<HTMLElement>(
      "[data-home-gallery-empty]",
    );
    const homeGalleryCount = document.querySelector<HTMLElement>(
      "[data-home-gallery-count]",
    );

    fetch("/api/gallery/uploads", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then(async (response) => {
        if (!response.ok) return null;
        return (await response.json()) as { images: OnlineGalleryItem[] };
      })
      .then((payload) => {
        if (!payload || !homeGalleryGrid) return;
        const publicImages = payload.images.filter((image) => !image.locked);
        const latest = publicImages.slice(0, 4);
        if (homeGalleryCount) {
          homeGalleryCount.textContent = String(publicImages.length).padStart(
            2,
            "0",
          );
        }
        if (latest.length === 0) return;

        homeGalleryGrid.replaceChildren();
        latest.forEach((image, index) => {
          const item = document.createElement(image.locked ? "button" : "a");
          item.className = "home-gallery-item";
          if (item instanceof HTMLButtonElement) {
            item.type = "button";
            item.disabled = true;
            item.classList.add("is-private");
            item.setAttribute("aria-label", "私密图片，仅投稿者可见");
          } else {
            item.href = image.href;
            item.dataset.galleryOpen = "true";
            item.dataset.galleryTitle = image.title;
            item.dataset.gallerySrcset = image.srcSet;
            item.dataset.gallerySizes =
              "(max-width: 1915px) 94vw, 1800px";
          }

          const thumbnail = document.createElement("img");
          thumbnail.src = image.src;
          if (!image.locked) thumbnail.srcset = image.srcSet;
          thumbnail.sizes = "(max-width: 600px) 44vw, 24vw";
          thumbnail.alt = image.locked ? "私密图片" : image.title;
          thumbnail.loading = index === 0 ? "eager" : "lazy";
          thumbnail.decoding = "async";

          item.append(thumbnail);
          homeGalleryGrid.append(item);
        });
        homeGalleryGrid.hidden = false;
        if (homeGalleryEmpty) homeGalleryEmpty.hidden = true;
      })
      .catch(() => undefined);
  </script>
</BaseLayout>
