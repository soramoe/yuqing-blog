---
import type { BlogPost } from "../lib/blog";
import { formatDate, getReadingTime } from "../lib/blog";

interface Props {
  post: BlogPost;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<article class="post-card" style={`--card-index: ${index}`}>
  <div class="post-card-top">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    <span>{readingTime} 分钟阅读</span>
  </div>
  <h3>
    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h3>
  <p>{post.data.description}</p>
  <div class="post-card-footer">
    <div class="tag-list" aria-label="文章标签">
      {post.data.tags.slice(0, 3).map((tag) => (
        <a href={`/tags/${tag}/`} class="tag">#{tag}</a>
      ))}
    </div>
    <a class="text-link" href={`/blog/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>
      阅读 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
