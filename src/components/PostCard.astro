---
import type { BlogPost } from "../lib/blog";
import { formatDate, getReadingTime } from "../lib/blog";

interface Props {
  post: BlogPost;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<article
  class="post-card"
  style={`--reveal-delay: ${Math.min(index, 5) * 55}ms`}
>
  <div class="post-cover">
    <a
      class="post-cover-link"
      href={`/blog/${post.id}/`}
      aria-label={`阅读《${post.data.title}》`}
    >
      {
        post.data.cover ? (
          <img
            src={post.data.cover}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="cover-fallback" aria-hidden="true">
            <span class="cover-label">FIELD NOTE</span>
            <span class="cover-glyph">
              {post.data.tags[0]?.slice(0, 1) ?? "渔"}
            </span>
            <span class="cover-tag">
              {post.data.tags[0] ? `#${post.data.tags[0]}` : "YUQING"}
            </span>
          </div>
        )
      }
      <span class="post-open" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="post-body">
    <div class="post-card-top">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      <span>{getReadingTime(post.body)} MIN</span>
    </div>
    <h2>
      <a href={`/blog/${post.id}/`} title={post.data.title}>
        {post.data.title}
      </a>
    </h2>
    <p class="post-description">{post.data.description}</p>
    <div class="post-card-footer">
      <a
        class="post-categories"
        href={`/categories/${encodeURIComponent(post.data.category)}/`}
        aria-label={`查看${post.data.category}分类`}
      >
        <span class="post-category-label">分类</span>
        <span>{post.data.category}</span>
      </a>
      {
        post.data.tags.length > 0 && (
          <div class="tag-list" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>
