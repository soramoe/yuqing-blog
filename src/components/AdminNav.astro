---
// 管理后台统一导航：所有 /admin/ 页面共用，保持一致的分类入口
const items = [
  { href: "/admin/", label: "后台首页" },
  { href: "/admin/stories/", label: "互动小说" },
  { href: "/admin/image/", label: "生图管理" },
  { href: "/admin/comments/", label: "评论审核" },
  { href: "/admin/gallery/", label: "图库管理" },
  { href: "/admin/points/", label: "积分管理" },
  { href: "/admin/shop/", label: "商城管理" },
];
const currentPath = Astro.url.pathname;
---

<nav class="admin-nav" aria-label="管理后台导航">
  {
    items.map((item) => (
      <a
        href={item.href}
        class:list={{
          active:
            item.href === "/admin/"
              ? currentPath === "/admin/" || currentPath === "/admin"
              : currentPath.startsWith(item.href),
        }}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
  }
  .admin-nav a {
    padding: 0.38rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .admin-nav a:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .admin-nav a.active {
    color: var(--on-accent, #fff);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 650;
  }
</style>
