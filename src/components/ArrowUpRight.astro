---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["ui-arrow", className]}
  viewBox="0 0 16 16"
  width="1em"
  height="1em"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M4 12 12 4M6 4h6v6"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
