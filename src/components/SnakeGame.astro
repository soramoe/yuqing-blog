<article class="game-entry" data-snake-game>
  <button
    class="game-entry-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="snake-player-panel"
    aria-label="打开并开始游戏：贪吃蛇"
    data-snake-toggle
  >
    <span class="game-preview" aria-hidden="true">
      <span class="preview-snake">
        <i style="--x: 3; --y: 8"></i>
        <i style="--x: 4; --y: 8"></i>
        <i style="--x: 5; --y: 8"></i>
        <i style="--x: 6; --y: 8"></i>
        <i style="--x: 7; --y: 8"></i>
      </span>
      <span class="preview-food"></span>
      <span class="preview-label">PLAYABLE / 01</span>
    </span>

    <span class="game-entry-copy">
      <span class="game-entry-meta">
        <span>ARCADE / 01</span>
        <span><i aria-hidden="true"></i> READY TO PLAY</span>
      </span>
      <span class="game-entry-title">
        <strong>贪吃蛇</strong>
        <span data-snake-toggle-label>立即游玩 ↗</span>
      </span>
      <span class="game-entry-description">
        控制小蛇吃掉光点，避开墙壁和自己的尾巴。键盘、方向按钮和滑动都能操作。
      </span>
      <span class="game-entry-tags" aria-hidden="true">
        <span># 街机</span>
        <span># 键盘</span>
        <span># 触屏</span>
      </span>
    </span>
  </button>

  <section
    class="snake-player"
    id="snake-player-panel"
    aria-labelledby="snake-game-title"
    hidden
    data-snake-player
  >
    <header class="snake-player-heading">
      <div>
        <p class="snake-eyebrow">INLINE GAME / SNAKE</p>
        <h2 id="snake-game-title">贪吃蛇</h2>
      </div>
      <button class="snake-close" type="button" data-snake-close>
        收起游戏 <span aria-hidden="true">×</span>
      </button>
    </header>

    <div class="snake-layout">
      <div class="snake-stage">
        <div class="snake-scoreboard" aria-live="polite">
          <div>
            <span>SCORE</span>
            <strong data-snake-score>000</strong>
          </div>
          <div>
            <span>BEST</span>
            <strong data-snake-best>000</strong>
          </div>
          <div>
            <span>LENGTH</span>
            <strong data-snake-length>03</strong>
          </div>
          <div class="snake-state">
            <span data-snake-status>准备开始</span>
            <button type="button" data-snake-pause disabled>暂停</button>
          </div>
        </div>

        <div class="snake-canvas-wrap">
          <canvas
            width="720"
            height="540"
            tabindex="0"
            role="img"
            aria-label="贪吃蛇游戏区域。使用方向键或 WASD 控制移动。"
            data-snake-canvas
          >
            你的浏览器不支持 Canvas，无法运行贪吃蛇游戏。
          </canvas>

          <div class="snake-overlay" data-snake-overlay hidden>
            <p class="snake-eyebrow" data-snake-overlay-label>READY?</p>
            <h3 data-snake-overlay-title>准备好了吗？</h3>
            <p data-snake-overlay-copy>
              吃掉光点会变长，速度也会慢慢加快。
            </p>
            <button type="button" data-snake-start>开始游戏</button>
          </div>
        </div>
      </div>

      <aside class="snake-controls" aria-label="贪吃蛇操作说明">
        <div>
          <p class="snake-eyebrow">CONTROLS</p>
          <h3>怎么玩</h3>
        </div>

        <div class="snake-instructions">
          <p><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd> 或 <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> 移动</p>
          <p><kbd>Space</kbd> / <kbd>P</kbd> 暂停</p>
          <p><kbd>Esc</kbd> 收起游戏</p>
        </div>

        <div class="snake-pad" aria-label="方向控制">
          <button type="button" data-snake-direction="up" aria-label="向上">↑</button>
          <button type="button" data-snake-direction="left" aria-label="向左">←</button>
          <button type="button" data-snake-direction="down" aria-label="向下">↓</button>
          <button type="button" data-snake-direction="right" aria-label="向右">→</button>
        </div>

        <p class="snake-tip">
          不要撞墙，也不要咬到自己的尾巴。吃得越多，跑得越快。
        </p>
      </aside>
    </div>
  </section>
</article>

<script>
  type Point = { x: number; y: number };
  type GameStatus = "ready" | "playing" | "paused" | "over";

  const gridColumns = 24;
  const gridRows = 18;
  const canvasWidth = 720;
  const canvasHeight = 540;
  const cellWidth = canvasWidth / gridColumns;
  const cellHeight = canvasHeight / gridRows;

  const game = document.querySelector<HTMLElement>("[data-snake-game]");
  const toggle = game?.querySelector<HTMLButtonElement>("[data-snake-toggle]");
  const toggleLabel = game?.querySelector<HTMLElement>(
    "[data-snake-toggle-label]",
  );
  const player = game?.querySelector<HTMLElement>("[data-snake-player]");
  const closeButton = game?.querySelector<HTMLButtonElement>(
    "[data-snake-close]",
  );
  const canvas = game?.querySelector<HTMLCanvasElement>("[data-snake-canvas]");
  const context = canvas?.getContext("2d");
  const scoreLabel = game?.querySelector<HTMLElement>("[data-snake-score]");
  const bestLabel = game?.querySelector<HTMLElement>("[data-snake-best]");
  const lengthLabel = game?.querySelector<HTMLElement>("[data-snake-length]");
  const statusLabel = game?.querySelector<HTMLElement>("[data-snake-status]");
  const pauseButton = game?.querySelector<HTMLButtonElement>(
    "[data-snake-pause]",
  );
  const overlay = game?.querySelector<HTMLElement>("[data-snake-overlay]");
  const overlayLabel = game?.querySelector<HTMLElement>(
    "[data-snake-overlay-label]",
  );
  const overlayTitle = game?.querySelector<HTMLElement>(
    "[data-snake-overlay-title]",
  );
  const overlayCopy = game?.querySelector<HTMLElement>(
    "[data-snake-overlay-copy]",
  );
  const startButton = game?.querySelector<HTMLButtonElement>(
    "[data-snake-start]",
  );

  if (
    game &&
    toggle &&
    toggleLabel &&
    player &&
    closeButton &&
    canvas &&
    context &&
    scoreLabel &&
    bestLabel &&
    lengthLabel &&
    statusLabel &&
    pauseButton &&
    overlay &&
    overlayLabel &&
    overlayTitle &&
    overlayCopy &&
    startButton
  ) {
    const directionByKey: Record<string, Point> = {
      ArrowUp: { x: 0, y: -1 },
      w: { x: 0, y: -1 },
      W: { x: 0, y: -1 },
      ArrowDown: { x: 0, y: 1 },
      s: { x: 0, y: 1 },
      S: { x: 0, y: 1 },
      ArrowLeft: { x: -1, y: 0 },
      a: { x: -1, y: 0 },
      A: { x: -1, y: 0 },
      ArrowRight: { x: 1, y: 0 },
      d: { x: 1, y: 0 },
      D: { x: 1, y: 0 },
    };
    const touchDirections: Record<string, Point> = {
      up: { x: 0, y: -1 },
      down: { x: 0, y: 1 },
      left: { x: -1, y: 0 },
      right: { x: 1, y: 0 },
    };

    let snake: Point[] = [];
    let food: Point = { x: 18, y: 9 };
    let direction: Point = { x: 1, y: 0 };
    let queuedDirection: Point = { x: 1, y: 0 };
    let status: GameStatus = "ready";
    let score = 0;
    let bestScore = readBestScore();
    let frameId = 0;
    let lastFrame = 0;
    let stepAccumulator = 0;
    let pointerStart: Point | null = null;

    const padNumber = (value: number) => String(value).padStart(3, "0");

    function readBestScore() {
      try {
        return Number(window.localStorage.getItem("yuqing-snake-best")) || 0;
      } catch {
        return 0;
      }
    }

    function saveBestScore(value: number) {
      try {
        window.localStorage.setItem("yuqing-snake-best", String(value));
      } catch {
        // The game still works when storage is unavailable.
      }
    }

    function samePoint(a: Point, b: Point) {
      return a.x === b.x && a.y === b.y;
    }

    function randomFood() {
      const freeCells: Point[] = [];

      for (let y = 0; y < gridRows; y += 1) {
        for (let x = 0; x < gridColumns; x += 1) {
          if (!snake.some((segment) => segment.x === x && segment.y === y)) {
            freeCells.push({ x, y });
          }
        }
      }

      food =
        freeCells[Math.floor(Math.random() * freeCells.length)] ??
        { x: 2, y: 2 };
    }

    function resetGame() {
      snake = [
        { x: 10, y: 9 },
        { x: 9, y: 9 },
        { x: 8, y: 9 },
      ];
      direction = { x: 1, y: 0 };
      queuedDirection = { x: 1, y: 0 };
      score = 0;
      randomFood();
      updateScoreboard();
      drawGame();
    }

    function updateScoreboard() {
      scoreLabel.textContent = padNumber(score);
      lengthLabel.textContent = String(snake.length).padStart(2, "0");
      bestLabel.textContent = padNumber(bestScore);
    }

    function setStatus(nextStatus: GameStatus, label: string) {
      status = nextStatus;
      statusLabel.textContent = label;
      pauseButton.disabled = nextStatus !== "playing" && nextStatus !== "paused";
      pauseButton.textContent = nextStatus === "paused" ? "继续" : "暂停";
    }

    function showOverlay(
      label: string,
      title: string,
      copy: string,
      buttonText: string,
    ) {
      overlayLabel.textContent = label;
      overlayTitle.textContent = title;
      overlayCopy.textContent = copy;
      startButton.textContent = buttonText;
      overlay.hidden = false;
    }

    function hideOverlay() {
      overlay.hidden = true;
    }

    function roundRect(
      context: CanvasRenderingContext2D,
      x: number,
      y: number,
      width: number,
      height: number,
      radius: number,
    ) {
      context.beginPath();
      context.roundRect(x, y, width, height, radius);
    }

    function drawGame() {
      context.fillStyle = "#0e1311";
      context.fillRect(0, 0, canvasWidth, canvasHeight);

      context.strokeStyle = "rgba(130, 152, 255, 0.09)";
      context.lineWidth = 1;
      for (let x = 1; x < gridColumns; x += 1) {
        context.beginPath();
        context.moveTo(x * cellWidth, 0);
        context.lineTo(x * cellWidth, canvasHeight);
        context.stroke();
      }
      for (let y = 1; y < gridRows; y += 1) {
        context.beginPath();
        context.moveTo(0, y * cellHeight);
        context.lineTo(canvasWidth, y * cellHeight);
        context.stroke();
      }

      const foodX = (food.x + 0.5) * cellWidth;
      const foodY = (food.y + 0.5) * cellHeight;
      context.save();
      context.shadowColor = "#ffb45c";
      context.shadowBlur = 20;
      context.fillStyle = "#ffb45c";
      context.beginPath();
      context.arc(foodX, foodY, Math.min(cellWidth, cellHeight) * 0.23, 0, Math.PI * 2);
      context.fill();
      context.restore();

      snake.forEach((segment, index) => {
        const inset = index === 0 ? 3 : 4;
        const x = segment.x * cellWidth + inset;
        const y = segment.y * cellHeight + inset;
        const width = cellWidth - inset * 2;
        const height = cellHeight - inset * 2;

        context.fillStyle = index === 0 ? "#c6d0ff" : "#8298ff";
        roundRect(context, x, y, width, height, index === 0 ? 9 : 7);
        context.fill();
      });

      const head = snake[0];
      if (head) {
        const centerX = (head.x + 0.5) * cellWidth;
        const centerY = (head.y + 0.5) * cellHeight;
        const forwardX = direction.x * 4;
        const forwardY = direction.y * 4;
        const sideX = direction.y * 5;
        const sideY = direction.x * 5;

        context.fillStyle = "#10110f";
        for (const side of [-1, 1]) {
          context.beginPath();
          context.arc(
            centerX + forwardX + sideX * side,
            centerY + forwardY + sideY * side,
            2.5,
            0,
            Math.PI * 2,
          );
          context.fill();
        }
      }
    }

    function finishGame() {
      if (frameId) window.cancelAnimationFrame(frameId);
      frameId = 0;
      setStatus("over", "游戏结束");
      overlay.hidden = false;
      const isNewBest = score > bestScore;

      if (isNewBest) {
        bestScore = score;
        saveBestScore(bestScore);
      }

      updateScoreboard();
      showOverlay(
        "GAME OVER",
        score > 0 ? `本局 ${score} 分` : "撞到了",
        isNewBest
          ? "新的最高分！再来一局，看看能不能更长。"
          : "吃光点会变长。调整方向，再试一次。",
        "再来一局",
      );
    }

    function stepGame() {
      direction = queuedDirection;
      const head = snake[0];
      if (!head) return;

      const nextHead = {
        x: head.x + direction.x,
        y: head.y + direction.y,
      };
      const willEat = samePoint(nextHead, food);
      const body = willEat ? snake : snake.slice(0, -1);
      const hitsWall =
        nextHead.x < 0 ||
        nextHead.x >= gridColumns ||
        nextHead.y < 0 ||
        nextHead.y >= gridRows;
      const hitsBody = body.some((segment) => samePoint(segment, nextHead));

      if (hitsWall || hitsBody) {
        finishGame();
        return;
      }

      snake.unshift(nextHead);
      if (willEat) {
        score += 10;
        randomFood();
      } else {
        snake.pop();
      }

      updateScoreboard();
      drawGame();
    }

    function getStepDuration() {
      return Math.max(72, 145 - Math.floor(score / 30) * 8);
    }

    function animate(time: number) {
      if (status !== "playing") return;
      if (!lastFrame) lastFrame = time;

      const elapsed = Math.min(time - lastFrame, 100);
      lastFrame = time;
      stepAccumulator += elapsed;

      if (stepAccumulator >= getStepDuration()) {
        stepAccumulator = 0;
        stepGame();
      }

      if (status === "playing") {
        frameId = window.requestAnimationFrame(animate);
      }
    }

    function startLoop() {
      if (frameId) window.cancelAnimationFrame(frameId);
      lastFrame = 0;
      stepAccumulator = 0;
      frameId = window.requestAnimationFrame(animate);
    }

    function startGame() {
      resetGame();
      hideOverlay();
      setStatus("playing", "进行中");
      startLoop();
      canvas.focus({ preventScroll: true });
    }

    function pauseGame(nextStatus: "playing" | "paused") {
      if (status === "over" || status === "ready") return;

      if (nextStatus === "paused") {
        if (frameId) window.cancelAnimationFrame(frameId);
        frameId = 0;
        setStatus("paused", "已暂停");
        showOverlay(
          "PAUSED",
          "先歇一下",
          "游戏已经暂停，点击继续或按空格。",
          "继续游戏",
        );
        return;
      }

      hideOverlay();
      setStatus("playing", "进行中");
      startLoop();
      canvas.focus({ preventScroll: true });
    }

    function togglePause() {
      if (status === "paused") {
        pauseGame("playing");
      } else if (status === "playing") {
        pauseGame("paused");
      } else if (status === "over" || status === "ready") {
        startGame();
      }
    }

    function changeDirection(nextDirection: Point) {
      if (status === "over" || status === "ready") return;
      const isReverse =
        nextDirection.x === -direction.x &&
        nextDirection.y === -direction.y;
      if (!isReverse) queuedDirection = nextDirection;
      if (status === "paused") pauseGame("playing");
    }

    function openGame() {
      player.hidden = false;
      game.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggleLabel.textContent = "收起游戏 ↑";
      startGame();
      window.requestAnimationFrame(() => {
        player.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    }

    function closeGame() {
      if (frameId) window.cancelAnimationFrame(frameId);
      frameId = 0;
      player.hidden = true;
      game.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggleLabel.textContent = "立即游玩 ↗";
      setStatus("ready", "准备开始");
      hideOverlay();
      toggle.focus({ preventScroll: true });
    }

    function updateBestLabel() {
      bestScore = readBestScore();
      updateScoreboard();
    }

    toggle.addEventListener("click", () => {
      if (player.hidden) {
        openGame();
      } else {
        closeGame();
      }
    });

    closeButton.addEventListener("click", closeGame);
    startButton.addEventListener("click", startGame);
    pauseButton.addEventListener("click", togglePause);

    for (const button of game.querySelectorAll<HTMLButtonElement>(
      "[data-snake-direction]",
    )) {
      button.addEventListener("click", () => {
        const directionName = button.dataset.snakeDirection;
        const nextDirection = directionName
          ? touchDirections[directionName]
          : null;
        if (nextDirection) changeDirection(nextDirection);
      });
    }

    canvas.addEventListener("pointerdown", (event) => {
      pointerStart = { x: event.clientX, y: event.clientY };
      canvas.setPointerCapture?.(event.pointerId);
    });

    canvas.addEventListener("pointerup", (event) => {
      if (!pointerStart) return;
      const deltaX = event.clientX - pointerStart.x;
      const deltaY = event.clientY - pointerStart.y;
      pointerStart = null;

      if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < 18) return;
      changeDirection(
        Math.abs(deltaX) > Math.abs(deltaY)
          ? { x: Math.sign(deltaX), y: 0 }
          : { x: 0, y: Math.sign(deltaY) },
      );
    });

    canvas.addEventListener("pointercancel", () => {
      pointerStart = null;
    });

    document.addEventListener("keydown", (event) => {
      if (player.hidden) return;

      const nextDirection = directionByKey[event.key];
      if (nextDirection) {
        event.preventDefault();
        changeDirection(nextDirection);
        return;
      }

      if (event.key === " " || event.key === "p" || event.key === "P") {
        event.preventDefault();
        togglePause();
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        closeGame();
      }
    });

    window.addEventListener("storage", (event) => {
      if (event.key === "yuqing-snake-best") updateBestLabel();
    });

    resetGame();
    updateScoreboard();
    drawGame();
  }
</script>

<style>
  .game-entry {
    margin-top: 26px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }

  .game-entry-trigger {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
    grid-template-columns: minmax(210px, 0.34fr) minmax(0, 1fr);
  }

  .game-entry-trigger:hover .preview-snake,
  .game-entry-trigger:focus-visible .preview-snake {
    filter: brightness(1.15);
  }

  .game-preview {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 250px;
    border-right: 1px solid var(--border);
    background:
      linear-gradient(rgba(130, 152, 255, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(130, 152, 255, 0.09) 1px, transparent 1px),
      radial-gradient(circle at 72% 33%, rgba(130, 152, 255, 0.15), transparent 28%),
      #0e1311;
    background-size: 26px 26px, 26px 26px, auto, auto;
  }

  .preview-snake {
    position: absolute;
    top: 34%;
    left: 20%;
    width: 260px;
    height: 150px;
    transform: rotate(-5deg);
    transition: filter 180ms ease;
  }

  .preview-snake i {
    position: absolute;
    left: calc(var(--x) * 23px);
    top: calc(var(--y) * 13px);
    width: 26px;
    height: 20px;
    border-radius: 5px;
    background: #8298ff;
    box-shadow: 0 0 16px rgba(130, 152, 255, 0.22);
  }

  .preview-snake i:last-child {
    background: #c6d0ff;
  }

  .preview-food {
    position: absolute;
    top: 30%;
    left: 56%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffb45c;
    box-shadow: 0 0 20px #ffb45c;
  }

  .preview-label {
    position: absolute;
    bottom: 18px;
    left: 20px;
    color: rgba(238, 240, 233, 0.54);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  .game-entry-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: clamp(22px, 3.4vw, 40px);
  }

  .game-entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .game-entry-meta i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: #73d59b;
  }

  .game-entry-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin: 22px 0 12px;
  }

  .game-entry-title strong {
    font-size: clamp(2rem, 4vw, 3.8rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .game-entry-title > span {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.76rem;
  }

  .game-entry-description {
    max-width: 640px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .game-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.62rem;
  }

  .game-entry.is-open .game-preview {
    background-color: #111613;
  }

  .game-entry.is-open .game-entry-title > span {
    color: var(--muted);
  }

  .snake-player {
    padding: clamp(18px, 3vw, 34px);
    border-top: 1px solid var(--strong-border);
    background: #0c0f0d;
  }

  .snake-player[hidden] {
    display: none;
  }

  .snake-player-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
  }

  .snake-eyebrow {
    margin: 0;
    color: rgba(238, 240, 233, 0.46);
    font-family: Consolas, monospace;
    font-size: 0.58rem;
