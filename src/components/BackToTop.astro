<button
  class="back-to-top"
  type="button"
  aria-label="返回页面顶部"
  aria-hidden="true"
  tabindex="-1"
  data-back-to-top
>
  <span class="back-to-top-arrow" aria-hidden="true">↑</span>
  <span class="back-to-top-label" aria-hidden="true">TOP</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  let visible = false;

  const setVisible = (nextVisible: boolean) => {
    if (!button || visible === nextVisible) return;

    visible = nextVisible;
    button.classList.toggle("is-visible", nextVisible);
    button.setAttribute("aria-hidden", String(!nextVisible));
    button.tabIndex = nextVisible ? 0 : -1;
  };

  const updateVisibility = () => {
    setVisible(window.scrollY > 560);
  };

  button?.addEventListener("click", () => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
  });

  window.addEventListener("scroll", updateVisibility, { passive: true });
  updateVisibility();
</script>

<style>
  .back-to-top {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(22px, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    width: 54px;
    height: 62px;
    padding: 8px 0 7px;
    place-items: center;
    border: 1px solid var(--strong-border);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--surface) 92%, transparent);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      border-color 160ms ease;
    backdrop-filter: blur(12px);
  }

  .back-to-top::before {
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in srgb, var(--border) 68%, transparent);
    content: "";
    pointer-events: none;
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    border-color: var(--accent);
  }

  .back-to-top-arrow {
    position: relative;
    z-index: 1;
    color: var(--accent);
    font-size: 1.25rem;
    line-height: 1;
  }

  .back-to-top-label {
    position: relative;
    z-index: 1;
    color: var(--muted);
    font-family: Consolas, monospace;
    font-size: 0.52rem;
    letter-spacing: 0.12em;
  }

  @media (max-width: 820px) {
    .back-to-top {
      right: max(14px, env(safe-area-inset-right));
      bottom: max(16px, env(safe-area-inset-bottom));
      width: 48px;
      height: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
