<div
  class="gallery-lightbox"
  data-gallery-lightbox
  role="dialog"
  aria-modal="true"
  aria-label="图片预览"
  hidden
>
  <button
    class="gallery-lightbox-close"
    type="button"
    data-gallery-lightbox-close
    aria-label="关闭图片预览"
  >
    <span>关闭</span>
    <span aria-hidden="true">×</span>
  </button>
  <figure class="gallery-lightbox-figure">
    <img data-gallery-lightbox-image alt="" />
    <figcaption data-gallery-lightbox-caption></figcaption>
  </figure>
</div>

<script>
  const lightbox = document.querySelector("[data-gallery-lightbox]");
  const lightboxImage = document.querySelector(
    "[data-gallery-lightbox-image]",
  ) as HTMLImageElement | null;
  const lightboxCaption = document.querySelector(
    "[data-gallery-lightbox-caption]",
  );
  const closeButton = document.querySelector(
    "[data-gallery-lightbox-close]",
  ) as HTMLButtonElement | null;
  let activeTrigger: HTMLElement | null = null;
  let closeTimer = 0;

  const closeLightbox = () => {
    if (!lightbox || lightbox.hasAttribute("hidden")) return;

    lightbox.classList.remove("is-open");
    document.body.classList.remove("gallery-lightbox-open");
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => {
      lightbox.setAttribute("hidden", "");
      lightboxImage?.removeAttribute("src");
    }, 180);
    activeTrigger?.focus();
  };

  const openLightbox = (trigger: HTMLElement) => {
    if (!lightbox || !lightboxImage || !lightboxCaption || !closeButton) return;

    activeTrigger = trigger;
    window.clearTimeout(closeTimer);
    const srcSet = trigger.dataset.gallerySrcset;
    const sizes = trigger.dataset.gallerySizes;

    if (srcSet) {
      lightboxImage.sizes = sizes || "100vw";
      lightboxImage.srcset = srcSet;
    } else {
      lightboxImage.removeAttribute("sizes");
      lightboxImage.removeAttribute("srcset");
    }
    lightboxImage.src = trigger.getAttribute("href") || "";
    lightboxImage.alt = trigger.dataset.galleryTitle || "渔情图库图片";
    lightboxCaption.textContent = trigger.dataset.galleryTitle || "";
    lightbox.removeAttribute("hidden");
    document.body.classList.add("gallery-lightbox-open");
    requestAnimationFrame(() => lightbox.classList.add("is-open"));
    closeButton.focus();
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const trigger = event.target.closest<HTMLElement>("[data-gallery-open]");
    if (!trigger) return;
    if (
      event instanceof MouseEvent &&
      (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
    ) {
      return;
    }

    event.preventDefault();
    openLightbox(trigger);
  });

  closeButton?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (event) => {
    if (!lightbox || lightbox.hasAttribute("hidden")) return;

    if (event.key === "Escape") {
      closeLightbox();
    } else if (event.key === "Tab") {
      event.preventDefault();
      closeButton?.focus();
    }
  });
  window.addEventListener("pagehide", closeLightbox);
</script>
