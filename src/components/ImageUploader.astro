---
import { GALLERY_UPLOAD_MAX_BYTES } from "../lib/gallery-upload";

interface Props {
  mode: "public" | "admin";
}

const { mode } = Astro.props;
const maxMegabytes = Math.round(GALLERY_UPLOAD_MAX_BYTES / 1024 / 1024);
---

<section
  class="image-uploader"
  data-image-uploader
  data-upload-mode={mode}
  aria-labelledby={`image-uploader-title-${mode}`}
>
  <div class="image-uploader-heading">
    <div>
      <p class="eyebrow">{mode === "admin" ? "DIRECT PUBLISH" : "PUBLIC SUBMISSION"}</p>
      <h2 id={`image-uploader-title-${mode}`}>
        {mode === "admin" ? "上传并发布" : "投稿图片"}
      </h2>
    </div>
    <span data-upload-quota>
      {mode === "admin" ? "站长上传无需审核" : "正在读取今日额度…"}
    </span>
  </div>

  <form data-image-upload-form>
    <label class="image-dropzone" data-image-dropzone>
      <input
        type="file"
        accept="image/jpeg,image/png,image/webp,image/avif"
        multiple
        data-image-input
      />
      <span class="image-dropzone-icon" aria-hidden="true">＋</span>
      <strong data-image-pick-label>选择或拖入图片</strong>
      <small>支持一次选择多张，JPG、PNG、WebP、AVIF，单张原图最大 {maxMegabytes} MB</small>
    </label>

    <div
      class="image-upload-preview-list"
      data-image-preview
      hidden
    ></div>

    <label class="image-title-field">
      <span>标题（可选）</span>
      <input
        type="text"
        maxlength="80"
        placeholder="不填写时使用文件名或当天日期"
        data-image-title
      />
    </label>

    <div class="image-upload-foot">
      <p data-image-upload-status aria-live="polite">
        图片会自动压缩为 480、960、1920 三档 WebP。
      </p>
      <button type="submit" data-image-submit disabled>
        {mode === "admin" ? "上传并发布" : "提交审核"}
      </button>
    </div>
  </form>
</section>

<script>
  import { GALLERY_UPLOAD_MAX_BYTES } from "../lib/gallery-upload";

  const root = document.querySelector<HTMLElement>("[data-image-uploader]");
  if (root) {
    const mode = root.dataset.uploadMode as "public" | "admin";
    const form = root.querySelector<HTMLFormElement>(
      "[data-image-upload-form]",
    );
    const input = root.querySelector<HTMLInputElement>("[data-image-input]");
    const dropzone = root.querySelector<HTMLElement>("[data-image-dropzone]");
    const pickLabel = root.querySelector<HTMLElement>(
      "[data-image-pick-label]",
    );
    const previewList = root.querySelector<HTMLElement>(
      "[data-image-preview]",
    );
    const title = root.querySelector<HTMLInputElement>("[data-image-title]");
    const uploadStatus = root.querySelector<HTMLElement>(
      "[data-image-upload-status]",
    );
    const quotaLabel = root.querySelector<HTMLElement>("[data-upload-quota]");
    const submit = root.querySelector<HTMLButtonElement>("[data-image-submit]");

    interface SelectedImage {
      id: string;
      file: File;
      previewUrl: string;
      width: number;
      height: number;
    }

    interface QuotaInfo {
      authenticated: boolean;
      isAdmin: boolean;
      dailyLimit: number;
      remaining: number;
    }

    let selectedImages: SelectedImage[] = [];
    let quotaInfo: QuotaInfo | null = null;
    let busy = false;

    const setStatus = (
      message: string,
      state: "idle" | "error" | "success" = "idle",
    ) => {
      if (!uploadStatus) return;
      uploadStatus.textContent = message;
      uploadStatus.dataset.state = state;
    };

    const quotaProblem = () => {
      if (mode !== "public") return "";
      if (quotaInfo?.isAdmin) {
        return "站长请使用专用上传入口。";
      }
      if (
        quotaInfo &&
        selectedImages.length > quotaInfo.remaining
      ) {
        const identity = quotaInfo.authenticated ? "登录用户" : "未登录用户";
        return `上传次数不足：今日剩余 ${quotaInfo.remaining} 张，当前选择 ${selectedImages.length} 张。${identity}每天最多上传 ${quotaInfo.dailyLimit} 张。`;
      }
      return "";
    };

    const updateSubmit = () => {
      const problem = quotaProblem();
      if (submit) {
        submit.disabled =
          busy || selectedImages.length === 0 || Boolean(problem);
      }
      if (problem) setStatus(problem, "error");
    };

    const releaseImage = (image: SelectedImage) => {
      URL.revokeObjectURL(image.previewUrl);
    };

    const renderPreviews = () => {
      if (!previewList) return;
      previewList.replaceChildren();

      selectedImages.forEach((image, index) => {
        const item = document.createElement("article");
        item.className = "image-upload-preview-item";

        const preview = document.createElement("img");
        preview.src = image.previewUrl;
        preview.alt = `待上传图片 ${index + 1}`;

        const info = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = image.file.name;
        const meta = document.createElement("span");
        meta.textContent = `${image.width} × ${image.height} · ${(image.file.size / 1024 / 1024).toFixed(1)} MB`;
        info.append(name, meta);

        item.append(preview, info);
        previewList.append(item);
      });

      previewList.hidden = selectedImages.length === 0;
      if (pickLabel) {
        pickLabel.textContent =
          selectedImages.length > 0
            ? `已选择 ${selectedImages.length} 张，重新选择`
            : "选择或拖入图片";
      }
      updateSubmit();
    };

    const decodeImage = async (file: File) => {
      if ("createImageBitmap" in window) {
        const bitmap = await createImageBitmap(file);
        return {
          source: bitmap as CanvasImageSource,
          width: bitmap.width,
          height: bitmap.height,
          dispose: () => bitmap.close(),
        };
      }

      const url = URL.createObjectURL(file);
      const image = new Image();
      await new Promise<void>((resolve, reject) => {
        image.onload = () => resolve();
        image.onerror = () => reject(new Error("无法读取这张图片。"));
        image.src = url;
      });
      return {
        source: image,
        width: image.naturalWidth,
        height: image.naturalHeight,
        dispose: () => URL.revokeObjectURL(url),
      };
    };

    const createVariant = async (
      source: CanvasImageSource,
      sourceWidth: number,
      sourceHeight: number,
      targetWidth: number,
    ) => {
      const height = Math.max(
        1,
        Math.round((sourceHeight / sourceWidth) * targetWidth),
      );
      const canvas = document.createElement("canvas");
      canvas.width = targetWidth;
      canvas.height = height;
      const context = canvas.getContext("2d");
      if (!context) throw new Error("浏览器无法处理这张图片。");
      context.drawImage(source, 0, 0, targetWidth, height);
      const blob = await new Promise<Blob | null>((resolve) => {
        canvas.toBlob(resolve, "image/webp", 0.86);
      });
      if (!blob || blob.type !== "image/webp") {
        throw new Error("浏览器无法生成 WebP 图片。");
      }
      return blob;
    };

    const loadQuota = async () => {
      if (mode !== "public") return;
      try {
        const response = await fetch("/api/gallery/upload-info", {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error();
        quotaInfo = (await response.json()) as QuotaInfo;
        if (quotaLabel) {
          quotaLabel.textContent = quotaInfo.isAdmin
            ? "站长请使用专用上传入口"
            : `${quotaInfo.authenticated ? "已登录" : "未登录"} · 今日剩余 ${quotaInfo.remaining}/${quotaInfo.dailyLimit} 张`;
        }
        updateSubmit();
      } catch {
        if (quotaLabel) quotaLabel.textContent = "今日额度暂时无法读取";
      }
    };

    const chooseFiles = async (files: File[]) => {
      if (files.length === 0) return;
      const validFiles: File[] = [];
      let rejected = 0;

      for (const file of files) {
        if (!/^image\/(jpeg|png|webp|avif)$/i.test(file.type)) {
          rejected += 1;
          continue;
        }
        if (file.size > GALLERY_UPLOAD_MAX_BYTES) {
          rejected += 1;
          continue;
        }
        validFiles.push(file);
      }

      selectedImages.forEach(releaseImage);
      selectedImages = [];
      for (const file of validFiles) {
        try {
          const decoded = await decodeImage(file);
          selectedImages.push({
            id: crypto.randomUUID(),
            file,
            previewUrl: URL.createObjectURL(file),
            width: decoded.width,
            height: decoded.height,
          });
          decoded.dispose();
        } catch {
          rejected += 1;
        }
      }

      if (title) {
        title.value =
          selectedImages.length === 1
            ? selectedImages[0].file.name.replace(/\.[^.]+$/, "").slice(0, 80)
            : "";
      }
      renderPreviews();

      const problem = quotaProblem();
      if (problem) {
        setStatus(problem, "error");
      } else if (rejected > 0) {
        setStatus(
          `已选择 ${selectedImages.length} 张，另有 ${rejected} 个文件因格式、大小或读取失败被忽略。`,
          "error",
        );
      } else {
        setStatus(
          selectedImages.length > 1
            ? `已选择 ${selectedImages.length} 张图片，提交后会逐张上传。`
            : "图片已选择，提交后会生成三种尺寸。",
        );
      }
    };

    input?.addEventListener("change", () => {
      void chooseFiles(Array.from(input.files ?? []));
    });

    ["dragenter", "dragover"].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropzone.classList.add("is-dragging");
      });
    });
    ["dragleave", "drop"].forEach((eventName) => {
      dropzone?.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropzone.classList.remove("is-dragging");
      });
    });
    dropzone?.addEventListener("drop", (event) => {
      void chooseFiles(Array.from(event.dataTransfer?.files ?? []));
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy || selectedImages.length === 0 || !submit) {
        setStatus("请先选择图片。", "error");
        return;
      }
      const problem = quotaProblem();
      if (problem) {
        setStatus(problem, "error");
        return;
      }

      busy = true;
      submit.disabled = true;
      let completed = 0;
      const successfulIds = new Set<string>();
      const total = selectedImages.length;
      const heading = title?.value.trim() ?? "";

      try {
        for (const image of [...selectedImages]) {
          setStatus(`正在上传第 ${completed + 1}/${total} 张…`);
          const decoded = await decodeImage(image.file);
          const variants = new Map<number, Blob>();
          for (const width of [480, 960, 1920]) {
            variants.set(
              width,
              await createVariant(
                decoded.source,
                decoded.width,
                decoded.height,
                width,
              ),
            );
          }
          decoded.dispose();

          const data = new FormData();
          data.append(
            "title",
            heading
              ? total > 1
                ? `${heading} · ${String(completed + 1).padStart(2, "0")}`
                : heading
              : image.file.name.replace(/\.[^.]+$/, "").slice(0, 80),
          );
          data.append("width", String(image.width));
          data.append("height", String(image.height));
          for (const [width, blob] of variants) {
            data.append(`variant-${width}`, blob, `variant-${width}.webp`);
          }

          const endpoint =
            mode === "admin"
              ? "/api/admin/gallery/upload"
              : "/api/gallery/upload";
          const response = await fetch(endpoint, {
            method: "POST",
            credentials: "same-origin",
            body: data,
          });
          const payload = (await response.json()) as {
            error?: string;
            requiresReview?: boolean;
            adminUploadUrl?: string;
          };
          if (!response.ok) {
            if (payload.adminUploadUrl) {
              throw new Error(
                `${payload.error ?? "请使用专用入口。"} ${location.origin}${payload.adminUploadUrl}`,
              );
            }
            throw new Error(payload.error || "图片上传失败。");
          }

          successfulIds.add(image.id);
          completed += 1;
          window.dispatchEvent(
            new CustomEvent("gallery-uploaded", { detail: payload }),
          );
        }

        const successfulImages = selectedImages.filter((image) =>
          successfulIds.has(image.id),
        );
        successfulImages.forEach(releaseImage);
        selectedImages = selectedImages.filter(
          (image) => !successfulIds.has(image.id),
        );
        if (input) input.value = "";
        if (title) title.value = "";
        renderPreviews();
        await loadQuota();
        setStatus(
          mode === "public"
            ? `已成功提交 ${completed} 张图片，等待站长审核。`
            : `已成功上传 ${completed} 张图片，并发布到图库。`,
          "success",
        );
      } catch (error) {
        const successfulImages = selectedImages.filter((image) =>
          successfulIds.has(image.id),
        );
        successfulImages.forEach(releaseImage);
        selectedImages = selectedImages.filter(
          (image) => !successfulIds.has(image.id),
        );
        renderPreviews();
        await loadQuota();
        const partial =
          completed > 0 ? `已完成 ${completed} 张，` : "";
        setStatus(
          `${partial}${error instanceof Error ? error.message : "图片上传失败，请稍后重试。"}`,
          "error",
        );
      } finally {
        busy = false;
        updateSubmit();
      }
    });

    window.addEventListener("pagehide", () => {
      selectedImages.forEach(releaseImage);
    });

    void loadQuota();
  }
</script>
