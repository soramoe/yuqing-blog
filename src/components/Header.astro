---
import { SITE } from "../site.config";

const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "文章" },
  { href: "/search/", label: "搜索" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 首页`}>
      <span class="brand-mark">渔</span>
      <span>{SITE.name}<span class="brand-dot">.</span></span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={{ active: Astro.url.pathname === item.href }}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="切换深浅主题"
      title="切换深浅主题"
    >
      <span class="theme-icon-light" aria-hidden="true">☀</span>
      <span class="theme-icon-dark" aria-hidden="true">☾</span>
    </button>
  </div>
</header>
