---
import { SITE } from "../site.config";

const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "博客" },
  { href: "/gallery/", label: "图库" },
  { href: "/ai-image/", label: "AI 生图" },
  { href: "/stories/", label: "互动小说" },
  { href: "/games/", label: "游戏" },
  { href: "/tools/", label: "工具" },
  { href: "/deals/", label: "额度" },
  { href: "/shop/", label: "兑换" },
  { href: "/about/", label: "关于" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 首页`}>
      <span class="brand-symbol" aria-hidden="true">渔</span>
      <span class="brand-word">{SITE.name}<span class="brand-dot">.</span></span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          class:list={{ active: isActive(item.href) }}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span class="nav-index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span>{item.label}</span>
        </a>
      ))}
      <a
        href="/notifications/"
        class:list={{ active: currentPath.startsWith("/notifications") }}
        data-notif-nav
        hidden
      >
        <span class="nav-index" aria-hidden="true">
          {String(navItems.length + 1).padStart(2, "0")}
        </span>
        <span>站内信</span>
        <span class="nav-bell-badge" data-notif-badge hidden></span>
      </a>
      <a
        href="/login/"
        class:list={{
          active:
            currentPath.startsWith("/login") ||
            currentPath.startsWith("/account"),
        }}
        data-auth-nav
      >
        <span class="nav-index" aria-hidden="true">
          {String(navItems.length + 2).padStart(2, "0")}
        </span>
        <span data-auth-label>登录</span>
      </a>
    </nav>

  </div>
</header>

<script>
  const authNav = document.querySelector<HTMLAnchorElement>("[data-auth-nav]");
  const authLabel = authNav?.querySelector<HTMLElement>("[data-auth-label]");

  // 窄屏导航是横向滚动条，项数多时当前页可能落在可视区外，进来先滚到它
  const nav = document.querySelector<HTMLElement>(".site-nav");
  const activeNavLink = nav?.querySelector<HTMLElement>("a.active");
  if (nav && activeNavLink && nav.scrollWidth > nav.clientWidth) {
    const navRect = nav.getBoundingClientRect();
    const linkRect = activeNavLink.getBoundingClientRect();
    nav.scrollLeft +=
      linkRect.left - navRect.left - (nav.clientWidth - linkRect.width) / 2;
  }

  if (authNav && authLabel) {
    // 登录态与未读数缓存：导航瞬间就按上次状态呈现，消除「消失再出现」的闪烁；
    // 随后用 get-session 异步校准（在别处退出登录等场景会自动纠正）。
    const AUTH_CACHE_KEY = "yq-auth-logged-in";
    const UNREAD_CACHE_KEY = "yq-notif-unread";

    const cacheGet = (name: string) => {
      try {
        return window.localStorage.getItem(name);
      } catch {
        return null;
      }
    };
    const cacheSet = (name: string, value: string) => {
      try {
        window.localStorage.setItem(name, value);
      } catch {
        // 隐私模式等场景下忽略
      }
    };

    const applyAuthState = (loggedIn: boolean, unread?: number) => {
      if (!authNav || !authLabel) return;
      const notifNav = document.querySelector<HTMLElement>("[data-notif-nav]");
      const badge = document.querySelector<HTMLElement>("[data-notif-badge]");
      if (loggedIn) {
        authNav.href = "/account/";
        authLabel.textContent = "账户";
        if (notifNav) notifNav.hidden = false;
        if (badge && typeof unread === "number" && unread > 0) {
          badge.hidden = false;
          badge.textContent = unread > 9 ? "9+" : String(unread);
        }
      } else {
        authNav.href = "/login/";
        authLabel.textContent = "登录";
        if (notifNav) notifNav.hidden = true;
        if (badge) badge.hidden = true;
      }
    };

    // 1) 缓存优先呈现
    if (cacheGet(AUTH_CACHE_KEY) === "1") {
      const cachedUnread = Number(cacheGet(UNREAD_CACHE_KEY) ?? "0");
      applyAuthState(true, Number.isFinite(cachedUnread) ? cachedUnread : 0);
    }

    // 2) 后台校准真实状态
    // 静态站没有 /api 时请求会立刻 404，或超时被 abort，两种情况都保持当前显示。
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 4000);

    fetch("/api/auth/get-session", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
      signal: controller.signal,
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data?.user) {
          // 未登录（或已在别处退出）：清缓存并恢复「登录」
          window.localStorage.removeItem(AUTH_CACHE_KEY);
          window.sessionStorage.removeItem(UNREAD_CACHE_KEY);
          applyAuthState(false);
          return;
        }
        cacheSet(AUTH_CACHE_KEY, "1");
        applyAuthState(true);
        // 登录后拉取未读站内信数量
        fetch("/api/notifications", {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((payload) => {
            const unread = Number(payload?.unread ?? 0);
            window.sessionStorage.setItem(UNREAD_CACHE_KEY, String(unread));
            applyAuthState(true, unread);
          })
          .catch(() => undefined);
      })
      .catch(() => undefined)
      .finally(() => window.clearTimeout(timer));
  }
</script>

<style>
  /* 站内信导航项的未读角标：跟在文字后面的小胶囊 */
  .nav-bell-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent, #fff);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.15;
  }
  .nav-bell-badge[hidden] {
    display: none;
  }
</style>
