---
import { SITE } from "../site.config";

const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog/", label: "博客" },
  { href: "/gallery/", label: "图库" },
  { href: "/about/", label: "关于" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 首页`}>
      <span class="brand-symbol" aria-hidden="true">渔</span>
      <span class="brand-word">{SITE.name}<span class="brand-dot">.</span></span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item, index) => (
        <a
          href={item.href}
          class:list={{ active: isActive(item.href) }}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          <span class="nav-index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span>{item.label}</span>
        </a>
      ))}
      <a
        href="/login/"
        class:list={{
          active:
            currentPath.startsWith("/login") ||
            currentPath.startsWith("/account"),
        }}
        data-auth-nav
      >
        <span class="nav-index" aria-hidden="true">05</span>
        <span data-auth-label>登录</span>
      </a>
    </nav>

  </div>
</header>

<script>
  const authNav = document.querySelector<HTMLAnchorElement>("[data-auth-nav]");
  const authLabel = authNav?.querySelector<HTMLElement>("[data-auth-label]");

  if (authNav && authLabel) {
    fetch("/api/auth/get-session", {
      credentials: "same-origin",
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data?.user) return;
        authNav.href = "/account/";
        authLabel.textContent = "账户";
      })
      .catch(() => undefined);
  }
</script>
