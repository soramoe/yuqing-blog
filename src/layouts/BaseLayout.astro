---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import SearchIsland from "../components/SearchIsland.astro";
import { SITE } from "../site.config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  schemaType?: "WebSite" | "WebPage" | "AboutPage" | "Blog" | "CollectionPage";
  publishedTime?: Date;
  updatedTime?: Date;
  section?: string;
  keywords?: string[];
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = "/og-default.png",
  type = "website",
  schemaType = "WebPage",
  publishedTime,
  updatedTime,
  section,
  keywords = [],
  noindex = false,
  bodyClass,
} = Astro.props;

const siteName = SITE.name;
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
const siteUrl = new URL("/", Astro.site ?? Astro.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, Astro.site ?? Astro.url);
const rssUrl = new URL("/rss.xml", Astro.site ?? Astro.url);
const aboutUrl = new URL("/about/", siteUrl);
const showSearchIsland =
  type !== "article" && Astro.url.pathname.startsWith("/blog/");
const websiteId = new URL("/#website", siteUrl).toString();

const websiteEntity = {
  "@type": "WebSite",
  "@id": websiteId,
  name: siteName,
  url: siteUrl.toString(),
  inLanguage: "zh-CN",
};
const publisherEntity = {
  "@type": "Organization",
  name: siteName,
  url: siteUrl.toString(),
};

const structuredData = noindex
  ? null
  : type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "@id": `${canonical.toString()}#article`,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonical.toString(),
        },
        headline: title,
        name: title,
        description,
        url: canonical.toString(),
        image: {
          "@type": "ImageObject",
          url: socialImage.toString(),
        },
        author: {
          "@type": "Person",
          name: SITE.author.name,
          url: aboutUrl.toString(),
        },
        publisher: publisherEntity,
        inLanguage: "zh-CN",
        ...(publishedTime
          ? {
              datePublished: publishedTime.toISOString(),
              dateModified: (updatedTime ?? publishedTime).toISOString(),
            }
          : {}),
        ...(section ? { articleSection: section } : {}),
        ...(keywords.length > 0 ? { keywords } : {}),
        isPartOf: websiteEntity,
      }
    : schemaType === "WebSite"
      ? {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": websiteId,
          name: pageTitle,
          alternateName: SITE.tagline,
          description,
          url: canonical.toString(),
          inLanguage: "zh-CN",
          publisher: publisherEntity,
        }
      : {
          "@context": "https://schema.org",
          "@type": schemaType,
          "@id": `${canonical.toString()}#${schemaType}`,
          name: pageTitle,
          description,
          url: canonical.toString(),
          inLanguage: "zh-CN",
          isPartOf: websiteEntity,
        };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10110f" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={rssUrl}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{pageTitle}</title>
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body class:list={[bodyClass, { "has-search-island": showSearchIsland }]}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    {showSearchIsland && <SearchIsland />}
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
