{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuqing-blog",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  // 普通文本变量（机密类在 Cloudflare 仪表板里管理）
  "vars": {
    "IMAGE_COLAB_URL": "https://concerned-composer-lumpiness.ngrok-free.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuqing-auth",
      "database_id": "4b91b2b2-2830-4676-8292-911ada646157"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "yuqing-media"
    },
    {
      "binding": "MEDIA_PRIVATE_BUCKET",
      "bucket_name": "yuqing-private-media"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
